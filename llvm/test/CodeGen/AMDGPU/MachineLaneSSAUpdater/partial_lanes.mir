# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=test-machine-lane-ssa-updater -verify-machineinstrs %s -o - | FileCheck %s

# Test partial lane SSA reconstruction
# - Wide register (vreg_128) with multiple subregisters
# - New definition only affects sub0 lanes
# - Uses of sub0 should be rewritten
# - Uses of other subregisters should remain unchanged
# - REG_SEQUENCE may be needed for mixed uses

--- |
  define amdgpu_kernel void @partial_lanes() {
    ret void
  }
...
---
name: partial_lanes
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sgpr0_sgpr1_sgpr2_sgpr3
    ; CHECK-LABEL: bb.0:
    ; Wide register with 4 sub-registers
    ; CHECK: %0:vreg_128 = IMPLICIT_DEF
    %0:vreg_128 = IMPLICIT_DEF
    
    ; Use full register before new def
    ; CHECK: S_NOP 0, implicit %0
    S_NOP 0, implicit %0
    
    ; Use specific lanes
    ; CHECK: S_NOP 1, implicit %0.sub0
    S_NOP 1, implicit %0.sub0
    ; CHECK: S_NOP 2, implicit %0.sub1
    S_NOP 2, implicit %0.sub1
    
  bb.1:
    ; CHECK-LABEL: bb.1:
    ; Test pass will insert new definition for sub0 only
    ; %1:vgpr_32 = V_MOV_B32_e32 100
    ; Call addDefAndRepairNewDef(%0, Sub0LaneMask)
    ; CHECK: %[[NEWSUB0:[0-9]+]]:vgpr_32 = V_MOV_B32_e32 100
    
  bb.2:
    ; CHECK-LABEL: bb.2:
    ; Use of sub0 should be rewritten to new vreg
    ; CHECK: S_NOP 0, implicit %[[NEWSUB0]]
    S_NOP 0, implicit %0.sub0
    
    ; Use of sub1 should still reference original %0
    ; CHECK: S_NOP 1, implicit %0.sub1
    S_NOP 1, implicit %0.sub1
    
    ; Use of sub2 should still reference original %0
    ; CHECK: S_NOP 2, implicit %0.sub2
    S_NOP 2, implicit %0.sub2
    
    ; Mixed use needing multiple lanes - may require REG_SEQUENCE
    ; If it uses both sub0 and sub1:
    ; CHECK: %[[REGSEQ:[0-9]+]]:vreg_64 = REG_SEQUENCE %[[NEWSUB0]], %subreg.sub0, %0.sub1, %subreg.sub1
    ; CHECK: S_NOP 3, implicit %[[REGSEQ]]
    S_NOP 3, implicit %0.sub0_sub1
    
    S_ENDPGM 0
...

