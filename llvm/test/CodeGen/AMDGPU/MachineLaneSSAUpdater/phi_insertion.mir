# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx900 -run-pass=test-machine-lane-ssa-updater -verify-machineinstrs %s -o - | FileCheck %s

# Test PHI insertion at control flow join points
# - Diamond control flow: bb.0 -> {bb.1, bb.2} -> bb.3
# - New definition in bb.1 only
# - Original continues through bb.2
# - PHI must be inserted at bb.3
# - Uses after join point reference PHI result

--- |
  define amdgpu_kernel void @phi_insertion(i32 %cond) {
  entry:
    br label %if
  if:
    br i1 undef, label %then, label %else
  then:
    br label %join
  else:
    br label %join
  join:
    ret void
  }
...
---
name: phi_insertion
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0
    ; CHECK-LABEL: bb.0:
    ; CHECK: %0:vgpr_32 = IMPLICIT_DEF
    %0:vgpr_32 = IMPLICIT_DEF
    
    ; Branch based on condition
    %1:sreg_32 = S_MOV_B32 0
    S_CBRANCH_SCC0 %bb.2, implicit $scc
    
  bb.1:
    successors: %bb.3
    ; CHECK-LABEL: bb.1:
    ; New definition in then-branch
    ; Test pass inserts: %2:vgpr_32 = V_MOV_B32_e32 42
    ; CHECK: %[[THENREG:[0-9]+]]:vgpr_32 = V_MOV_B32_e32 42
    S_BRANCH %bb.3
    
  bb.2:
    successors: %bb.3
    ; CHECK-LABEL: bb.2:
    ; Original continues in else-branch
    ; CHECK: S_NOP 0, implicit %0
    S_NOP 0, implicit %0
    S_BRANCH %bb.3
    
  bb.3:
    ; CHECK-LABEL: bb.3:
    ; PHI must be inserted here by MachineLaneSSAUpdater
    ; CHECK: %[[PHI:[0-9]+]]:vgpr_32 = PHI %[[THENREG]], %bb.1, %0, %bb.2
    
    ; Uses after join point reference PHI result
    ; CHECK: S_NOP 0, implicit %[[PHI]]
    S_NOP 0, implicit %0
    
    ; CHECK: S_NOP 1, implicit %[[PHI]]
    S_NOP 1, implicit %0
    
    S_ENDPGM 0
...

