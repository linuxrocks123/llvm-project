# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Two-pass architecture - VGPR spilling
#
# Scenario:
# - VGPR pressure exceeds limit
# - Spiller runs VGPR pass and spills %v_far
#
# Note: Testing SGPR spilling requires different setup since SGPRs
# are spilled to VGPR lanes, not memory. This test focuses on VGPR pass.
#
# CHECK-LABEL: name: two_pass_vgpr
# VGPR spill
# CHECK: SI_SPILL_V32_SAVE %v_far
# CHECK: SI_VIRTUAL_SPILL_MARKER %v_far
# VGPR reload
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @two_pass_vgpr() #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }

  ; Tight VGPR limit
  attributes #0 = { "amdgpu-num-vgpr"="3" "target-cpu"="gfx1200" }
...
---
name:            two_pass_vgpr
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)

    ; Define VGPR values - %v_far has longest NUD (used in bb.2)
    %v0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %v1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %v_far:vgpr_32 = V_MOV_B32_e32 200, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)

    ; Create VGPR pressure - %v_far has longest NUD
    %v3:vgpr_32 = V_ADD_U32_e32 %v0, %v1, implicit $exec
    %v4:vgpr_32 = V_ADD_U32_e32 %v3, %v0, implicit $exec
    %v5:vgpr_32 = V_ADD_U32_e32 %v4, %v1, implicit $exec
    
    S_BRANCH %bb.2

  bb.2.use:
    ; Use %v_far - trigger reload
    %v_result:vgpr_32 = V_ADD_U32_e32 %v_far, %v5, implicit $exec
    
    S_ENDPGM 0, implicit %v_result
...
