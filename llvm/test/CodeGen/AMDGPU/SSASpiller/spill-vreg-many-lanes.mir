# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller --amdgpu-ssa-spill-markers=1 %s -o - | FileCheck %s
#
# Test lane-aware spilling with vreg_1024 register class (32 VGPRs)
#
# This test validates handling of large register classes where subregisters
# are accessed individually. With amdgpu-num-vgpr=13, the spiller must handle
# each lane separately, creating multiple IDF computations per register.
#

--- |
  ; ModuleID = 'test1.mir'
  source_filename = "test1.ll"
  target datalayout = "e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-p7:160:256:256:32-p8:128:128:128:48-p9:192:256:256:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn"

  define void @stack_args_vgpr_spill(<32 x float> %arg0, <32 x float> %arg1, ptr addrspace(1) %p) #0 {
    %tid = call i32 @llvm.amdgcn.workitem.id.x()
    %idxprom = sext i32 %tid to i64
    %p1 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p, i64 %idxprom
    %p2 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p1, i64 %idxprom
    %p3 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p2, i64 %idxprom
    %p4 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p3, i64 %idxprom
    %p5 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p4, i64 %idxprom
    %p6 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p5, i64 %idxprom
    %p7 = getelementptr inbounds <32 x float>, ptr addrspace(1) %p6, i64 %idxprom
    %v1 = load volatile <32 x float>, ptr addrspace(1) %p1, align 128
    %v2 = load volatile <32 x float>, ptr addrspace(1) %p2, align 128
    %v3 = load volatile <32 x float>, ptr addrspace(1) %p3, align 128
    %v4 = load volatile <32 x float>, ptr addrspace(1) %p4, align 128
    %v5 = load volatile <32 x float>, ptr addrspace(1) %p5, align 128
    %v6 = load volatile <32 x float>, ptr addrspace(1) %p6, align 128
    %v7 = load volatile <32 x float>, ptr addrspace(1) %p7, align 128
    br label %st, !amdgpu.uniform !0

  st:                                               ; preds = %0
    store volatile <32 x float> %arg0, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %arg1, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v1, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v2, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v3, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v4, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v5, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v6, ptr addrspace(1) undef, align 128
    store volatile <32 x float> %v7, ptr addrspace(1) undef, align 128
    ret void
  }

  ; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
  declare noundef range(i32 0, 1024) i32 @llvm.amdgcn.workitem.id.x() #1

  ; Function Attrs: nocallback nofree nounwind willreturn
  declare { i1, i64 } @llvm.amdgcn.if.i64(i1) #2

  ; Function Attrs: nocallback nofree nounwind willreturn
  declare { i1, i64 } @llvm.amdgcn.else.i64.i64(i64) #2

  ; Function Attrs: nocallback nofree nounwind willreturn memory(none)
  declare i64 @llvm.amdgcn.if.break.i64(i1, i64) #3

  ; Function Attrs: nocallback nofree nounwind willreturn
  declare i1 @llvm.amdgcn.loop.i64(i64) #2

  ; Function Attrs: nocallback nofree nounwind willreturn
  declare void @llvm.amdgcn.end.cf.i64(i64) #2

  attributes #0 = { "amdgpu-flat-work-group-size"="1,256" "amdgpu-memory-bound"="true" "target-cpu"="gfx900" }
  attributes #1 = { nocallback nofree nosync nounwind speculatable willreturn memory(none) "target-cpu"="gfx900" }
  attributes #2 = { nocallback nofree nounwind willreturn "target-cpu"="gfx900" }
  attributes #3 = { nocallback nofree nounwind willreturn memory(none) "target-cpu"="gfx900" }

  !0 = !{}
...
