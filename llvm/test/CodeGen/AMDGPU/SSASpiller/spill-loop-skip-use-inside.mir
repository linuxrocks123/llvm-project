# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Skip candidate if use is inside loop
#
# Setup:
#   %bad: def in entry, use in loop.body → FILTERED (use in loop)
#   %good: def in entry, use in exit → KEPT (def/use outside loop)
#   %a0, %a1: used inside loop to create high RP → FILTERED (use in loop)
#
# NUD at high-RP (loop.body, before %bad's use):
#   %good → longest (use far in exit)
#   %bad → medium (use coming soon in this block)
#   %a0, %a1 → shortest (just used)
#
# Without filtering: %good selected (longest NUD)
# With filtering: %bad filtered (use in loop), only %good remains

# CHECK-LABEL: name: loop_skip_use_inside
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %good
# CHECK-NOT: SI_SPILL_V32_SAVE %bad

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @loop_skip_use_inside() #0 {
  entry:
    br label %loop.header
  loop.header:
    br i1 true, label %loop.body, label %exit
  loop.body:
    br label %loop.header
  exit:
    ret void
  }
  attributes #0 = { "amdgpu-num-vgpr"="4" }
...
---
name:            loop_skip_use_inside
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    ; Both defined outside loop
    %good:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %bad:vgpr_32 = V_MOV_B32_e32 99, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_BRANCH %bb.1

  bb.1.loop.header:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2.loop.body:
    successors: %bb.1(0x80000000)
    ; High RP early, then %bad used INSIDE loop (should be filtered)
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    ; %bad used here - this makes it filtered (use in loop)
    %p3:vgpr_32 = V_ADD_U32_e32 %p2, %bad, implicit $exec
    S_BRANCH %bb.1

  bb.3.exit:
    ; %good used OUTSIDE loop - it's the only valid candidate
    dead %result:vgpr_32 = V_ADD_U32_e32 %good, %a0, implicit $exec
    S_ENDPGM 0
...
