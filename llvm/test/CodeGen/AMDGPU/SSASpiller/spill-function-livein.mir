# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Function with live-in arguments and spilling
#
# Scenario:
# - %arg copied from function argument (live-in)
# - %other defined normally
# - High RP triggers spill of %other (longer NUD)
# - Verifies spiller handles mix of live-in copies and normal defs
#
# CHECK-LABEL: name: function_livein
# CHECK: bb.0.entry:
# CHECK: COPY $vgpr0
# %other gets spilled (longest NUD)
# CHECK: SI_SPILL_V32_SAVE %other
# CHECK: bb.1.pressure:
# CHECK: SI_VIRTUAL_SPILL_MARKER %other
# CHECK: bb.2.use:
# Reload %other
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @function_livein(i32 %in) #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" "target-cpu"="gfx1200" }
...
---
name:            function_livein
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $vgpr0

    ; Copy function argument to virtual register
    %arg:vgpr_32 = COPY $vgpr0
    
    ; Define other registers - %other has longest NUD
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %other:vgpr_32 = V_ADD_U32_e32 %arg, %a0, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)

    ; Create high RP - arg, a0, other, p0 = 4 live (limit=3)
    ; %other has longest NUD (used in bb.2)
    ; %arg is used here (shorter NUD)
    %p0:vgpr_32 = V_ADD_U32_e32 %arg, %a0, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %arg, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a0, implicit $exec
    
    S_BRANCH %bb.2

  bb.2.use:
    ; Use %other - needs reload
    %result:vgpr_32 = V_ADD_U32_e32 %other, %p2, implicit $exec
    S_ENDPGM 0, implicit %result
...
