# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
# XFAIL: *
# FIXME: Loop-aware spill candidate filter can empty; validateFinalRegisterPressure fails until fallback exists.

# Test: Skip candidate if def is inside loop
#
# Scenario:
# - Spill point in bb.1 (loop body)
# - %bad: defined INSIDE loop (bb.1), used LAST in program (bb.2) - longest NUD
# - %good: defined OUTSIDE loop (bb.0), used in loop (bb.1) - shorter NUD
#
# NUD at high-RP point (bb.1 at %p0 def):
#   %a0, %a1: NUD = 0 (used at current instruction)
#   %good: NUD = 1 (used at next instruction %p1)
#   %bad: NUD = large (used in bb.2 exit) - longest overall
#
# Without loop filtering: %bad selected (longest NUD)
# With loop filtering: %bad SKIPPED (def in loop doesn't dominate preheader)
#                      %good selected (longest valid NUD)
#
# CHECK-LABEL: name: loop_skip_def_inside
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %good
# CHECK-NOT: SI_SPILL_V32_SAVE %bad

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @loop_skip_def_inside() #0 {
  entry:
    br label %loop
  loop:
    br i1 true, label %loop, label %exit
  exit:
    ret void
  }
  attributes #0 = { "amdgpu-num-vgpr"="5" "target-cpu"="gfx1200" }
...
---
name:            loop_skip_def_inside
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    ; %good defined OUTSIDE loop - valid spill candidate
    %good:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_BRANCH %bb.1

  bb.1.loop:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    ; %bad defined INSIDE loop - will be filtered out
    ; At this point: %good, %a0, %a1 live = 3, then %bad = 4 (at limit)
    %bad:vgpr_32 = V_MOV_B32_e32 99, implicit $exec
    
    ; HIGH RP at %p0: %good, %a0, %a1, %bad, %p0 = 5 (exceeds limit 4)
    ; NUD: %a0,%a1 = 0 (used here), %good = 1 (used at p1), %bad = far (used in exit)
    ; %bad has longest NUD but is filtered (def in loop)
    ; %good selected (longest valid NUD)
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %good, implicit $exec
    
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2.exit:
    ; %bad used here - it had longest NUD but was filtered
    %r1:vgpr_32 = V_ADD_U32_e32 %p1, %bad, implicit $exec
    dead %result:vgpr_32 = V_ADD_U32_e32 %r1, %a0, implicit $exec
    S_ENDPGM 0
...
