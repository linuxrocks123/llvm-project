# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller --amdgpu-ssa-spill-markers=1 -o - %s | FileCheck %s

# Test SSA spiller Pattern 2.2: Multi-Predecessor Join
# Verifies:
# 1. Register reaches join point via multiple paths
# 2. One path has high RP forcing spill, other paths are clean
# 3. PHI insertion at join point for flag propagation
# 4. Split-before-use at final use point
# 5. Value PHI after conditional reload

--- |
  target datalayout = "e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn"

  define amdgpu_kernel void @test_multi_pred(i32 %cond) #0 {
  entry:
    %cmp = icmp eq i32 %cond, 0
    br i1 %cmp, label %path_a, label %path_b

  path_a:
    br label %join

  path_b:
    br label %join

  join:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="8" "target-cpu"="gfx1200" }
...
---
name:            test_multi_pred
alignment:       1
tracksRegLiveness: true
noPhis:          false
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vreg_128 }
  - { id: 2, class: vreg_128 }
  - { id: 3, class: sreg_32 }
stack:
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: test_multi_pred
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vreg_128 = COPY $vgpr0_vgpr1_vgpr2_vgpr3
  ; CHECK-NEXT:   SI_SPILL_V128_SAVE [[COPY]], %stack.0, $sgpr32, 0, implicit $exec :: (store (s128) into %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   S_CMP_EQ_U32 [[COPY1]], 0, implicit-def $scc
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.path_a:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SI_VIRTUAL_SPILL_MARKER 0, 255
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vreg_128 = IMPLICIT_DEF
  ; CHECK-NEXT:   S_NOP 0, implicit [[DEF]]
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.path_b:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.join:
  ; CHECK-NEXT:   [[SI_SPILL_V128_RESTORE:%[0-9]+]]:vreg_128 = SI_SPILL_V128_RESTORE %stack.0, $sgpr32, 0, implicit $exec :: (load (s128) from %stack.0, align 4, addrspace 5)
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[SI_SPILL_V128_RESTORE]]

  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $vgpr0_vgpr1_vgpr2_vgpr3, $vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11, $sgpr0

    ; Define register that will reach join via multiple paths
    %0:vreg_128 = COPY $vgpr0_vgpr1_vgpr2_vgpr3

    ; Branch condition
    %3:sreg_32 = COPY $sgpr0
    S_CMP_EQ_U32 %3, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  ; Path A: High register pressure forces spill

  bb.1.path_a:
    successors: %bb.3(0x80000000)
    %1:vreg_128 = IMPLICIT_DEF
    ; Create high RP by loading more data from physical registers
    ; This forces %0 (which is already live) to be spilled
    ; Keep %0, %1, %2 all live to maintain high RP
    S_NOP 0, implicit %1
    S_BRANCH %bb.3

  ; Path B: Clean path (no spill)

  bb.2.path_b:
    successors: %bb.3(0x80000000)

    ; Clean path - %0 stays live without spilling
    S_BRANCH %bb.3

  ; Join point: %0 reaches here from both paths
  ; Path A: %0 was spilled (flag = 1)
  ; Path B: %0 is still in register (flag = 0)
  ; Spiller should insert flag PHI here and split-before-use

  ; Reload block (conditional on flag)

  ; Value PHI merging reload and original register

  bb.3.join:
    ; Use of %0 (not dominated - two paths converge here)
    ; %0 reaches here from path_a (where it was spilled due to RP)
    ; %0 reaches here from path_b (where it stayed live)
    S_ENDPGM 0, implicit %0

...

