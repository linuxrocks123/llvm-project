# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Spill point outside loop, def inside loop
# - High RP is OUTSIDE the loop (in high_rp block)
# - %x has def INSIDE loop but no filtering since high-RP is outside loop
# - %x should be spilled (longest NUD from high-RP point)

# CHECK-LABEL: name: loop_fallback_shift_exit
# CHECK: bb.1.loop.header:
# CHECK: SI_SPILL_V32_SAVE %x
# CHECK: bb.4.high_rp:
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @loop_fallback_shift_exit() #0 {
  entry:
    br label %loop.header
  loop.header:
    br i1 true, label %loop.body, label %loop.exit
  loop.body:
    br label %loop.header
  loop.exit:
    br label %high_rp
  high_rp:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            loop_fallback_shift_exit
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_BRANCH %bb.1

  bb.1.loop.header:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    
    ; %x defined inside loop
    %x:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2.loop.body:
    successors: %bb.1(0x80000000)
    
    %tmp:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %a0_next:vgpr_32 = V_ADD_U32_e32 %tmp, %a0, implicit $exec
    S_BRANCH %bb.1

  bb.3.loop.exit:
    successors: %bb.4(0x80000000)
    
    S_BRANCH %bb.4

  bb.4.high_rp:
    ; High RP here - need 5+ values live to exceed limit of 4
    ; %x, %a0, %a1 are live from before
    ; Create p0, p1, p2 all live at once
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    ; Use all of p0, p1, p2 together to keep them live
    %sum:vgpr_32 = V_ADD_U32_e32 %p0, %p1, implicit $exec
    %sum2:vgpr_32 = V_ADD_U32_e32 %sum, %p2, implicit $exec
    ; Use %x last
    dead %result:vgpr_32 = V_ADD_U32_e32 %x, %sum2, implicit $exec
    S_ENDPGM 0
...
