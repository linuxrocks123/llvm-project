# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-no-reload-opt \
# RUN:   -amdgpu-ssa-spill-markers -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Reload optimizer explicitly disabled
#
# Same setup as spill-reload-opt-basic.mir but with -amdgpu-ssa-spill-no-reload-opt
#
# Scenario:
# - Two uses of %x in separate blocks (bb.1 and bb.2)
# - WITHOUT optimizer: individual reloads at each use
# - WITH optimizer: single reload at NCD (entry block)
#
# This test verifies the -amdgpu-ssa-spill-no-reload-opt flag works correctly
# and that fixPathologicalPHIs is called in the non-optimized path.
#
# CHECK-LABEL: name: reload_opt_disabled
# CHECK: bb.0.entry:
# Store at def
# CHECK: SI_SPILL_V32_SAVE %x
# CHECK: SI_VIRTUAL_SPILL_MARKER %x
# NO reload at NCD (optimizer disabled)
# CHECK-NOT: SI_SPILL_V32_RESTORE
# CHECK: bb.1.left:
# Individual reload at use
# CHECK: SI_SPILL_V32_RESTORE
# CHECK: bb.2.right:
# Individual reload at use
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @reload_opt_disabled() #0 {
  entry:
    br i1 true, label %left, label %right
  left:
    br label %exit
  right:
    br label %exit
  exit:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" }
...
---
name:            reload_opt_disabled
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    
    ; Define %x
    %x:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    %a2:vgpr_32 = V_MOV_B32_e32 4, implicit $exec
    %a3:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
    
    ; Create pressure - %x has longest NUD
    %sum:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %sum2:vgpr_32 = V_ADD_U32_e32 %sum, %a2, implicit $exec
    %sum3:vgpr_32 = V_ADD_U32_e32 %sum2, %a3, implicit $exec
    
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.1.left:
    successors: %bb.3(0x80000000)
    
    ; Use %x - with optimizer disabled, reload happens here
    %left_result:vgpr_32 = V_ADD_U32_e32 %x, %sum3, implicit $exec
    S_BRANCH %bb.3

  bb.2.right:
    successors: %bb.3(0x80000000)
    
    ; Use %x - with optimizer disabled, reload happens here too
    %right_result:vgpr_32 = V_ADD_U32_e32 %x, %sum3, implicit $exec
    S_BRANCH %bb.3

  bb.3.exit:
    %final:vgpr_32 = PHI %left_result, %bb.1, %right_result, %bb.2
    S_ENDPGM 0, implicit %final
...
