# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -run-pass=amdgpu-ssa-register-spiller \
# RUN:   --amdgpu-ssa-spill-markers=1 -o - %s | FileCheck %s
#
# The spiller ranks spill candidates at lane granularity. At %c = V_ADD %x.sub0, %a
# the lane %x.sub0 and %a are read and both stay live afterwards (reused by %e), so
# the %c def cannot reuse an operand and pressure exceeds the num-vgpr=3 limit there.
# The only live lane NOT read by %c is %x.sub1 (used later), so the spiller must
# spill that sub-register — not the whole %x (needed via sub0) and not %a.
#
# Guards the "subtract the lanes MI reads" candidate selection: a sibling lane of a
# tuple stays spillable even when another lane of the same tuple is read here.

--- |
  define amdgpu_kernel void @spill_unused_lane() #0 {
    ret void
  }
  attributes #0 = { "amdgpu-num-vgpr"="3" }
...
---
name:            spill_unused_lane
tracksRegLiveness: true
isSSA:           true
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  bb.0:
    %x0:vgpr_32 = V_MOV_B32_e32 10, implicit $exec
    %x1:vgpr_32 = V_MOV_B32_e32 11, implicit $exec
    %x:vreg_64 = REG_SEQUENCE %x0, %subreg.sub0, %x1, %subreg.sub1
    %a:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %c:vgpr_32 = V_ADD_U32_e32 %x.sub0, %a, implicit $exec
    %e:vgpr_32 = V_XOR_B32_e32 %x.sub0, %a, implicit $exec
    %f:vgpr_32 = V_ADD_U32_e32 %c, %e, implicit $exec
    S_NOP 0, implicit %x.sub1
    S_ENDPGM 0, implicit %f
...

# CHECK-LABEL: name: spill_unused_lane
# The unused-at-MI lane (sub1) is spilled; sub0 is read by the V_ADD and kept.
# CHECK: SI_SPILL_V32_SAVE %x.sub1, %stack.[[#]]
# CHECK: SI_VIRTUAL_SPILL_MARKER %x, 000000000000000C
# CHECK: %c:vgpr_32 = V_ADD_U32_e32 %x.sub0, %a, implicit $exec
# sub1 reloaded before its late use; neither %a nor the full %x is spilled.
# CHECK: [[RLD:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE %stack.[[#]]
# CHECK: S_NOP 0, implicit [[RLD]]
# CHECK-NOT: SI_SPILL_V32_SAVE %a
