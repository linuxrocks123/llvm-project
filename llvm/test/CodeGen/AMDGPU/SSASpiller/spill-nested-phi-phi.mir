# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-no-reload-opt -amdgpu-ssa-spill-markers -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: nested diamonds -- a reconstruction PHI feeding another reconstruction PHI.
#
# CFG Structure:
#     bb.0 (entry, define x, SAVE x)
#       / \
#      v   \  (OUTER bypass: keeps ORIGINAL x)
#    bb.1   \
# (high RP,  \
#  free x)    \
#    / \       \
#   v   v       |
# bb.2  bb.3    |   (both use x -> both reload)
#   \   /       |
#    v v        |
#   bb.4        |   (inner join: PHI R1 = merge(reload_bb2, reload_bb3))
#     \         |
#      v        v
#      bb.5 <---+   (outer join: PHI R2 = merge(R1 from bb.4, ORIGINAL x from bb.0))
#   (use x)
#
# The inner-join PHI (R1) is consumed only by the outer-join PHI (R2), i.e. a
# PHI result feeds another PHI. This is the placeholder-then-patch path in the
# reconstruction: createPHIInBlockReaching emits an %x placeholder for the bb.4
# edge (its reaching value is a PHI-def), which R1's rewriteDominatedUses later
# patches to R1.
#
# Expected results:
# 1. SAVE x in bb.0, MARKER x in bb.1 (freed by pressure).
# 2. Reload + use in bb.2 and bb.3.
# 3. bb.4: inner merge PHI, NO reload.
# 4. bb.5: outer merge PHI of the inner PHI and the ORIGINAL x, NO reload.

# CHECK-LABEL: name: nested_phi_phi
# CHECK: bb.0.entry:
# CHECK:   SI_SPILL_V32_SAVE %x,
# CHECK: bb.1.inner_top:
# CHECK:   SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.2.inner_left:
# CHECK:   [[RL2:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK:   V_ADD_U32_e32 [[RL2]], %p0
# CHECK: bb.3.inner_right:
# CHECK:   [[RL3:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK:   V_ADD_U32_e32 [[RL3]], %p1
# CHECK: bb.4.inner_join:
# inner merge: PHI of the two reloaded values -- no reload here
# CHECK-NOT: SI_SPILL_V32_RESTORE
# CHECK:   [[INNER:%[0-9]+]]:vgpr_32 = PHI [[RL2]], %bb.2, [[RL3]], %bb.3
# CHECK: bb.5.outer_join:
# outer merge: PHI feeding from the ORIGINAL x (bb.0 bypass) and the inner-join
# PHI (bb.4) -- a reconstruction PHI result consumed by another PHI, no reload.
# CHECK-NOT: SI_SPILL_V32_RESTORE
# CHECK:   [[OUTER:%[0-9]+]]:vgpr_32 = PHI %x, %bb.0, [[INNER]], %bb.4
# CHECK:   V_ADD_U32_e32 [[OUTER]],
# CHECK:   S_ENDPGM

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @nested_phi_phi(i32 %in0) #0 {
  entry:
    br i1 true, label %inner_top, label %outer_join
  inner_top:
    br i1 true, label %inner_left, label %inner_right
  inner_left:
    br label %inner_join
  inner_right:
    br label %inner_join
  inner_join:
    br label %outer_join
  outer_join:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" }
...

---
name:            nested_phi_phi
isSSA:           true
tracksRegLiveness: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  ; =========================
  ; bb.0 (entry): define x, then branch to bb.1 (high RP) or bb.5 (outer bypass)
  ; =========================
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.5(0x40000000)

    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec

    %c_entry:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %c_entry, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.5

  ; =========================
  ; bb.1 (inner_top): high register pressure frees x
  ; =========================
  bb.1.inner_top:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)

    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec

    %c0:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %c0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  ; =========================
  ; bb.2 (inner_left): use x -> reload
  ; =========================
  bb.2.inner_left:
    successors: %bb.4(0x80000000)

    %ul:vgpr_32 = V_ADD_U32_e32 %x, %p0, implicit $exec
    S_BRANCH %bb.4

  ; =========================
  ; bb.3 (inner_right): use x -> reload
  ; =========================
  bb.3.inner_right:
    successors: %bb.4(0x80000000)

    %ur:vgpr_32 = V_ADD_U32_e32 %x, %p1, implicit $exec
    S_BRANCH %bb.4

  ; =========================
  ; bb.4 (inner_join): pure x flow-through; reconstruction merges the two reloads
  ; here (inner PHI R1), whose only consumer is the outer PHI in bb.5
  ; =========================
  bb.4.inner_join:
    successors: %bb.5(0x80000000)

    S_BRANCH %bb.5

  ; =========================
  ; bb.5 (outer_join): use x
  ; Predecessors: bb.4 (carries inner PHI R1), bb.0 (carries ORIGINAL x)
  ; =========================
  bb.5.outer_join:
    %w:vgpr_32 = V_ADD_U32_e32 %x, %a0, implicit $exec
    S_ENDPGM 0, implicit %w
...
