# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-no-reload-opt -amdgpu-ssa-spill-markers -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: Triangle CFG with bypass path (no use on some edges)
#
# CFG Structure:
#     bb.0 (entry, define x)
#       / \
#      v   \
#    bb.1   \
# (high RP)  \
#    / \      \
#   v   v      |
# bb.2  |      |
#(use x)|      |
#   |   |      |
#   v   v      |
#  bb.3 <+     |
# (use x)      |
#   |          |
#   v          v
#  bb.4 <------+
# (use x)
#
# Expected results:
# 1. reloads in bb.2 and bb.3 (both have uses of x)
# 2. PHI in bb.4 merging: reload from bb.3, ORIGINAL x from Entry->4 path

# CHECK-LABEL: name: triangle_phi
# CHECK: bb.0.entry:
# CHECK:   SI_SPILL_V32_SAVE %x,
# CHECK: bb.1.high_rp:
# CHECK:   SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.2.left:
# CHECK:   [[R2:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK:   V_ADD_U32_e32 [[R2]], %p0
# CHECK: bb.3.middle:
# CHECK:   [[R3:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK:   V_ADD_U32_e32 [[R3]], %m0
# CHECK: bb.4.exit:
# bb.4 merges the original x (bb.0 bypass, never spilled) with the bb.3 reload
# via a PHI -- no reload on the clean path.
# CHECK:   [[PHI4:%[0-9]+]]:vgpr_32 = PHI %x, %bb.0, [[R3]], %bb.3
# CHECK:   V_ADD_U32_e32 [[PHI4]], %e0
# CHECK:   S_ENDPGM 0

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @triangle_phi(i32 %in0) #0 {
  entry:
    br i1 true, label %high_rp, label %exit
  high_rp:
    br i1 true, label %left, label %middle
  left:
    br label %middle
  middle:
    br label %exit
  exit:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" }
...

---
name:            triangle_phi
isSSA:           true
tracksRegLiveness: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  ; =========================
  ; bb.0 (entry): Define x here, then branch to bb.1 (high RP) or bb.4 (bypass)
  ; =========================
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.4(0x40000000)

    ; Define x here - it will be live on ALL paths
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec

    ; branch: to high_rp path or bypass to exit
    %c_entry:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %c_entry, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.4

  ; =========================
  ; bb.1 (high_rp): High register pressure causes spill of x
  ; =========================
  bb.1.high_rp:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)

    ; Create pressure
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec

    ; branch: left (use x) or directly to middle (use x)
    %c0:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %c0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  ; =========================
  ; bb.2 (left): use x, goes to bb.3 (middle)
  ; =========================
  bb.2.left:
    successors: %bb.3(0x80000000)

    ; use x - triggers reload
    %u0:vgpr_32 = V_ADD_U32_e32 %x, %p0, implicit $exec

    S_BRANCH %bb.3

  ; =========================
  ; bb.3 (middle): use x
  ; Predecessors: bb.1 (no reload yet), bb.2 (has reload)
  ; =========================
  bb.3.middle:
    successors: %bb.4(0x80000000)

    ; PHI for computed values
    %m0:vgpr_32 = PHI %u0, %bb.2, %p1, %bb.1

    ; use x - triggers reload
    %v0:vgpr_32 = V_ADD_U32_e32 %x, %m0, implicit $exec

    S_BRANCH %bb.4

  ; =========================
  ; bb.4 (exit): use x
  ; Predecessors: bb.0 (bypass, has ORIGINAL x), bb.3 (has reload)
  ; =========================
  bb.4.exit:
    ; PHI for computed values from both paths
    %e0:vgpr_32 = PHI %v0, %bb.3, %a0, %bb.0

    ; use x - PHI merges reloaded value and original x
    %final0:vgpr_32 = V_ADD_U32_e32 %x, %e0, implicit $exec

    S_ENDPGM 0
...
