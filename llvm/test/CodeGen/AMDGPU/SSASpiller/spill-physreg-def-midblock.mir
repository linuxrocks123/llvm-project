# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: Physreg defined mid-block increases pressure → spill.
#       After physreg dies, pressure drops → no more spills.
#
# Live ranges:
#        MOV  MOV  MOV  MOV  NOP  MOV  ENDPGM
# %a      |====|====|====|====|====|====|
# %b           |====|====|====|====|====|
# $vgpr0            |====|====|
# %c                     |====|====|====|
# %d                                |====|
#
# amdgpu-num-vgpr=4, limit=3. Physreg def pushes total to 4 → spill.
# After physreg death, %d fits within limit → no second spill.
#
# CHECK-LABEL: name: physreg_def_midblock
# CHECK: SI_SPILL_V32_SAVE
# CHECK: S_NOP 0, implicit $vgpr0
# CHECK-NOT: SI_SPILL_V32_SAVE
# CHECK: S_ENDPGM

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @physreg_def_midblock() #0 {
  entry:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            physreg_def_midblock
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |

  bb.0.entry:
    %a:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %b:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    $vgpr0 = V_MOV_B32_e32 77, implicit $exec
    %c:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    S_NOP 0, implicit $vgpr0
    %d:vgpr_32 = V_MOV_B32_e32 4, implicit $exec
    S_ENDPGM 0, implicit %a, implicit %b, implicit %c, implicit %d
...
