# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: CFG with empty basic blocks
#
# Scenario:
# - Function has empty basic blocks in the CFG (only branch)
# - Spiller should skip empty blocks gracefully
# - Spilling and reload should work correctly around empty blocks
#
# CHECK-LABEL: name: empty_blocks
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %x
# Empty blocks skipped
# CHECK: bb.2.pressure:
# CHECK: SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.4.use:
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @empty_blocks() #0 {
  entry:
    br label %empty1
  empty1:
    br label %pressure
  pressure:
    br label %empty2
  empty2:
    br label %use
  use:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" "target-cpu"="gfx1200" }
...
---
name:            empty_blocks
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)

    ; Define %x
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    
    S_BRANCH %bb.1

  ; Empty block - spiller should skip this gracefully
  bb.1.empty1:
    successors: %bb.2(0x80000000)

    S_BRANCH %bb.2

  bb.2.pressure:
    successors: %bb.3(0x80000000)

    ; Create high RP - need tighter pressure
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    
    S_BRANCH %bb.3

  ; Another empty block
  bb.3.empty2:
    successors: %bb.4(0x80000000)

    S_BRANCH %bb.4

  bb.4.use:
    ; Use %x - needs reload
    %result:vgpr_32 = V_ADD_U32_e32 %x, %p2, implicit $exec
    S_ENDPGM 0, implicit %result
...
