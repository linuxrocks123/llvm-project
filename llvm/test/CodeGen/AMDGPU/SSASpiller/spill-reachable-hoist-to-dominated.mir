# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: reachable use becomes dominated after hoisting to NCD
# - Spill triggered in bb.1 (spill_path) due to high RP.
# - Use in bb.3 is reachable but not dominated by original kill point.
# - Hoisting to NCD makes the use dominated, so reload placed before use.
#
# CHECK-LABEL: name: spill_reachable_hoist_to_dominated
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %x
# CHECK: bb.3.join:
# CHECK: [[RELOAD:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK: V_ADD_U32_e32 [[RELOAD]], [[RELOAD]]

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @spill_reachable_hoist_to_dominated() #0 {
  entry:
    br i1 true, label %spill_path, label %clean_path
  spill_path:
    br label %join
  clean_path:
    br label %join
  join:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" "target-cpu"="gfx1200" }
...
---
name:            spill_reachable_hoist_to_dominated
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    %x:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.1.spill_path:
    successors: %bb.3(0x80000000)
    ; Define temps that push RP over limit (4-1=3), %x has furthest use so it spills
    %t0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %t1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %t2:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    ; Use and kill temps immediately
    dead %sum:vgpr_32 = V_ADD3_U32_e64 %t0, %t1, %t2, implicit $exec
    S_BRANCH %bb.3

  bb.2.clean_path:
    successors: %bb.3(0x80000000)
    S_BRANCH %bb.3

  bb.3.join:
    %use:vgpr_32 = V_ADD_U32_e32 %x, %x, implicit $exec
    S_ENDPGM 0
...
