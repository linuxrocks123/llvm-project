# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-SPILL
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-RA
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator,si-lower-sgpr-spills \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-LOWER

# Test: SGPR spill lowering — budget reduction coupling between Pass 1 and Pass 2
#
# CFG:
#
#   bb.0.entry ──► bb.1.pressure ──► bb.2.use
#
# Liveness:
#
#   %s_far:sreg_32  |══════════════════════════|  (def bb.0, use bb.2)
#   %v_far:vgpr_32  |══════════════════════════|  (def bb.0, use bb.2)
#   %s0–%s4:sreg_32          |══|               (def + die in bb.1)
#   %v0–%v2:vgpr_32          |══|               (def + die in bb.1)
#
# Pressure budget:
#   amdgpu-num-sgpr=8 → SGPR limit = floor(8 * 0.9) = 7
#   amdgpu-num-vgpr=4 → VGPR limit INITIAL = floor(4 * 0.9) = 3
#
# Pass 1 (SGPR): at %s5 def — %s_far + %s0–%s4 = 6 > 5 → %s_far spilled.
#   countSGPRSpillVGPRs() = 1 lane slot → VGPRLimit decremented: 3 → 2.
#
# Pass 2 (VGPR): limit is now 2 (not 3). At %v2 def — %v_far + %v0–%v2 = 4 > 2.
#   Both %v_far and %v1 are spilled.
#   WITHOUT the SGPR lane reservation, VGPR limit would be 3 and only ONE VGPR
#   spill (or none) would be needed. The extra spill is caused solely by the SGPR
#   lane VGPR consuming one slot from the VGPR budget.
#
# This test proves that countSGPRSpillVGPRs() correctly reduces the VGPR budget
# before Pass 2, ensuring the spiller does not over-allocate VGPRs.

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @sgpr_budget_reduction() #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }
  attributes #0 = { "amdgpu-num-sgpr"="8" "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            sgpr_budget_reduction
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; === Stage 1: Spiller — one SI_SPILL_S32 (SGPR) and two SI_SPILL_V32 (VGPR) ===
  ; The SGPR spill triggers VGPR budget reduction; two VGPRs must then be spilled.
  ; AFTER-SPILL-LABEL: name: sgpr_budget_reduction
  ; AFTER-SPILL:         SI_SPILL_S32_SAVE %{{.*}}, %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:         SI_SPILL_V32_SAVE %{{.*}}, %stack.1, $sgpr32, 0, implicit $exec
  ; AFTER-SPILL:       bb.1.pressure:
  ; AFTER-SPILL:         SI_SPILL_V32_SAVE %{{.*}}, %stack.2, $sgpr32, 0, implicit $exec

  ; === Stage 2: After SSA RA — physregs, three spill pseudos survive ===
  ; AFTER-RA-LABEL: name: sgpr_budget_reduction
  ; AFTER-RA:         $sgpr0 = S_MOV_B32 100
  ; AFTER-RA-NEXT:    SI_SPILL_S32_SAVE $sgpr0, %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-RA:         SI_SPILL_V32_SAVE $vgpr0, %stack.1, $sgpr32, 0, implicit $exec
  ; AFTER-RA:       bb.1.pressure:
  ; AFTER-RA:         SI_SPILL_V32_SAVE $vgpr1, %stack.2, $sgpr32, 0, implicit $exec

  ; === Stage 3: After SILowerSGPRSpills — SGPR pseudo → writelane; VGPR pseudos stay ===
  ; The SGPR spill is materialised to SI_SPILL_S32_TO_VGPR (one lane VGPR).
  ; The two VGPR spills remain as SI_SPILL_V32_SAVE (lowered by PEI, not here).
  ; AFTER-LOWER-LABEL: name: sgpr_budget_reduction
  ; AFTER-LOWER:         $sgpr0 = S_MOV_B32 100
  ; AFTER-LOWER-NEXT:    %[[LANE:[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; AFTER-LOWER-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, %[[LANE]]
  ; AFTER-LOWER:         SI_SPILL_V32_SAVE $vgpr0, %stack.1, $sgpr32, 0, implicit $exec
  ; AFTER-LOWER:       bb.1.pressure:
  ; AFTER-LOWER:         SI_SPILL_V32_SAVE $vgpr1, %stack.2, $sgpr32, 0, implicit $exec
  ; AFTER-LOWER:       bb.2.use:
  ; AFTER-LOWER:         $sgpr0 = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 0
  ; AFTER-LOWER:         SI_SPILL_V32_RESTORE %stack.1, $sgpr32, 0, implicit $exec
  ; AFTER-LOWER:         S_ENDPGM 0, implicit $sgpr0, implicit $vgpr0

  bb.0.entry:
    successors: %bb.1(0x80000000)
    %s_far:sreg_32 = S_MOV_B32 100
    %v_far:vgpr_32 = V_MOV_B32_e32 200, implicit $exec
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)
    %s0:sreg_32 = S_MOV_B32 1
    %s1:sreg_32 = S_MOV_B32 2
    %s2:sreg_32 = S_MOV_B32 3
    %s3:sreg_32 = S_MOV_B32 4
    %s4:sreg_32 = S_MOV_B32 5
    S_NOP 0, implicit %s0, implicit %s1, implicit %s2, implicit %s3, implicit %s4
    %v0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %v1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %v2:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    S_NOP 0, implicit %v0, implicit %v1, implicit %v2
    S_BRANCH %bb.2

  bb.2.use:
    %s_res:sreg_32 = S_ADD_I32 %s_far, %s_far, implicit-def $scc
    %v_res:vgpr_32 = V_ADD_U32_e32 %v_far, %v_far, implicit $exec
    S_ENDPGM 0, implicit %s_res, implicit %v_res
...
