# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Register selected for spill at multiple high-RP points
#
# Scenario:
# - %x defined in bb.0
# - High RP in bb.1 triggers first spill consideration of %x
# - Same register %x may be considered again if still live
# - Only ONE store should be emitted (at definition)
#
# Note: After first spill, %x is removed from Active set for RP purposes,
# so it won't be selected again. This test verifies the store-at-def 
# mechanism produces exactly one store.
#
# CHECK-LABEL: name: double_spill_same_reg
# CHECK: bb.0.entry:
# Only ONE store right after def
# CHECK: %x:vgpr_32 = V_ADD_U32_e32
# CHECK-NEXT: SI_SPILL_V32_SAVE %x
# CHECK-NOT: SI_SPILL_V32_SAVE %x
# CHECK: bb.1.high_rp:
# Virtual spill marker
# CHECK: SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.2.use:
# Reload for use
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @double_spill_same_reg() #0 {
  entry:
    br label %high_rp
  high_rp:
    br label %use
  use:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" }
...
---
name:            double_spill_same_reg
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)

    ; Define %x - will be stored once after def
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.high_rp:
    successors: %bb.2(0x80000000)

    ; High RP point - %x selected for spill
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    
    S_BRANCH %bb.2

  bb.2.use:
    ; Use %x - reload needed
    %final:vgpr_32 = V_ADD_U32_e32 %x, %p2, implicit $exec
    S_ENDPGM 0, implicit %final
...
