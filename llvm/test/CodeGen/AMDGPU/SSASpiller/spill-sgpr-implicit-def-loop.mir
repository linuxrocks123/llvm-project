# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator,si-lower-sgpr-spills \
# RUN:   -o - %s | FileCheck %s

# Test: SGPR spill lowering — IMPLICIT_DEF placement, loop CFG
#
# CFG:
#
#   bb.0.preheader ──► bb.1.loop ◄──┐
#                          │         │
#                          └─────────┘ (back-edge)
#                          │
#                          ▼
#                    bb.2.exit
#
# Liveness:
#
#   %s_far:sreg_32  |══════════════════════════|  (def preheader, use exit)
#   %s0–%s4:sreg_32          |══|               (def + die in loop body)
#
# With amdgpu-num-sgpr=8 → limit = 5.
# In bb.1.loop: %s_far + %s0–%s4 = 6 > 5 → %s_far spilled.
# Store-at-def places SI_SPILL_S32_TO_VGPR in bb.0.preheader (where %s_far is defined).
#
# Key assertion — IMPLICIT_DEF placement:
#   The lane VGPR IMPLICIT_DEF must be placed in bb.0.preheader, NOT inside bb.1.loop.
#   If it were inside the loop, it would re-initialise the lane VGPR every iteration,
#   which is wasteful and semantically wrong (it should only fire once before the first
#   writelane). SILowerSGPRSpills computes LaneVGPRDomInstr as the dominating instruction
#   for the IMPLICIT_DEF — for a single spill site in the preheader, the dominator is
#   that same instruction (trivially), so IMPLICIT_DEF lands immediately before it.
#
# Pattern in preheader:
#   %N:vgpr_32 = IMPLICIT_DEF           ← once, before the loop
#   %N:vgpr_32 = SI_SPILL_S32_TO_VGPR   ← writelane
#
# The loop body has NO IMPLICIT_DEF and NO SI_SPILL.

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @sgpr_implicit_def_loop() #0 {
  preheader:
    br label %loop
  loop:
    %i = phi i32 [ 0, %preheader ], [ %i1, %loop ]
    %i1 = add i32 %i, 1
    %cond = icmp ult i32 %i1, 10
    br i1 %cond, label %loop, label %exit
  exit:
    ret void
  }
  attributes #0 = { "amdgpu-num-sgpr"="8" "target-cpu"="gfx1200" }
...
---
name:            sgpr_implicit_def_loop
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: sgpr_implicit_def_loop
  ; CHECK:       bb.0.preheader:
  ; CHECK:         $sgpr0 = S_MOV_B32 100
  ; CHECK-NEXT:    %[[LANE:[0-9a-z_]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, %[[LANE]]
  ; CHECK:       bb.1.loop:
  ; CHECK-NOT:     IMPLICIT_DEF
  ; CHECK-NOT:     SI_SPILL_S32_TO_VGPR
  ; CHECK:         S_BRANCH %bb.2
  ; CHECK:       bb.2.exit:
  ; CHECK:         $sgpr0 = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 0
  ; CHECK:         S_ENDPGM 0, implicit $sgpr0

  bb.0.preheader:
    successors: %bb.1(0x80000000)
    %s_far:sreg_32 = S_MOV_B32 100
    S_BRANCH %bb.1

  bb.1.loop:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    %s0:sreg_32 = S_MOV_B32 1
    %s1:sreg_32 = S_MOV_B32 2
    %s2:sreg_32 = S_MOV_B32 3
    %s3:sreg_32 = S_MOV_B32 4
    %s4:sreg_32 = S_MOV_B32 5
    S_NOP 0, implicit %s0, implicit %s1, implicit %s2, implicit %s3, implicit %s4
    %ctr:sreg_32 = S_ADD_I32 %s0, 1, implicit-def $scc
    S_CBRANCH_SCC0 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2.exit:
    %s_res:sreg_32 = S_ADD_I32 %s_far, %s_far, implicit-def $scc
    S_ENDPGM 0, implicit %s_res
...
