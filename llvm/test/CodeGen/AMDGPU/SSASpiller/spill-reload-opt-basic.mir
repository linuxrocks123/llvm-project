# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-spiller -amdgpu-ssa-spill-markers \
# RUN:   -o - %s | FileCheck %s

# Basic reload optimizer test:
# - Define %x in entry block
# - Create high RP to trigger spill
# - Two uses of %x in separate blocks that share a common dominator
# - Reload optimizer should place ONE reload at NCD (entry block)
#
# CFG:
#   entry (def %x, high RP) --> left (use %x) --> exit
#                          \--> right (use %x) -/

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @reload_opt_basic(i32 %in) #0 {
  entry:
    br i1 true, label %left, label %right
  left:
    br label %exit
  right:
    br label %exit
  exit:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" }
...
---
name:            reload_opt_basic
tracksRegLiveness: true
isSSA: true
registers:
stack:
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  ; CHECK-LABEL: name: reload_opt_basic
  
  ; Redesign: reloads are placed on demand at each freed use, NOT hoisted back
  ; into the entry block's high-pressure region. Each branch reloads its own copy.
  ; CHECK: bb.0.entry:
  ; CHECK: SI_SPILL_V32_SAVE
  ; CHECK: SI_VIRTUAL_SPILL_MARKER %x
  
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    
    ; Define values - create high register pressure
    %x:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    %a2:vgpr_32 = V_MOV_B32_e32 4, implicit $exec
    %a3:vgpr_32 = V_MOV_B32_e32 5, implicit $exec
    
    ; Create pressure point - uses a0..a3, %x is furthest next use
    ; This should trigger spill of %x
    %sum:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %sum2:vgpr_32 = V_ADD_U32_e32 %sum, %a2, implicit $exec
    %sum3:vgpr_32 = V_ADD_U32_e32 %sum2, %a3, implicit $exec
    
    ; Branch to left or right
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.1.left:
    successors: %bb.3(0x80000000)
    
    ; CHECK: bb.1.left:
    ; CHECK: [[R1:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
    ; CHECK: V_ADD_U32_e32 [[R1]]
    %left_result:vgpr_32 = V_ADD_U32_e32 %x, %sum3, implicit $exec
    S_BRANCH %bb.3

  bb.2.right:
    successors: %bb.3(0x80000000)
    
    ; CHECK: bb.2.right:
    ; CHECK: [[R2:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
    ; CHECK: V_ADD_U32_e32 [[R2]]
    %right_result:vgpr_32 = V_ADD_U32_e32 %x, %sum3, implicit $exec
    S_BRANCH %bb.3

  bb.3.exit:
    ; Use results from both paths
    ; CHECK: bb.3.exit:
    %final:vgpr_32 = PHI %left_result, %bb.1, %right_result, %bb.2
    S_ENDPGM 0, implicit %final
...
