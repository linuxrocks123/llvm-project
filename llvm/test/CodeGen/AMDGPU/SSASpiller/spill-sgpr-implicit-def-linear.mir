# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator,si-lower-sgpr-spills \
# RUN:   -o - %s | FileCheck %s

# Test: SGPR spill lowering — IMPLICIT_DEF placement, single-block function
#
# CFG:  single bb.0.entry (no branches)
#
# Liveness:
#
#   %s_far:sreg_32  |══════════════════════════|  (def + use in same block)
#   %s0–%s4:sreg_32      |══|                    (def + die before use of %s_far)
#
# With amdgpu-num-sgpr=8 → limit = 5.
# At %s5 def: %s_far + %s0–%s4 = 6 > 5 → %s_far spilled.
#
# Key assertion (IMPLICIT_DEF dominance, trivial single-block case):
#   The lane VGPR IMPLICIT_DEF must appear in bb.0 immediately before the first
#   SI_SPILL_S32_TO_VGPR. This is the trivial case of LaneVGPRDomInstr: both the
#   spill site and the only reference to the lane VGPR are in bb.0, so the
#   IMPLICIT_DEF is placed right before that first use.
#
# Pattern:
#   IMPLICIT_DEF %N:vgpr_32
#   SI_SPILL_S32_TO_VGPR $sgpr0, 0, %N   ← first (and only) write of %N
#   ...
#   SI_RESTORE_S32_FROM_VGPR %N, 0       ← only read of %N

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @sgpr_implicit_def_linear() #0 {
  entry:
    ret void
  }
  attributes #0 = { "amdgpu-num-sgpr"="8" "target-cpu"="gfx1200" }
...
---
name:            sgpr_implicit_def_linear
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: sgpr_implicit_def_linear
  ; CHECK:       bb.0.entry:
  ; CHECK:         $sgpr0 = S_MOV_B32 100
  ; CHECK-NEXT:    %[[LANE:[0-9a-z_]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, %[[LANE]]
  ; CHECK:         S_NOP 0
  ; CHECK:         $sgpr0 = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 0
  ; CHECK:         S_ENDPGM 0, implicit $sgpr0

  bb.0.entry:
    %s_far:sreg_32 = S_MOV_B32 100
    %s0:sreg_32 = S_MOV_B32 1
    %s1:sreg_32 = S_MOV_B32 2
    %s2:sreg_32 = S_MOV_B32 3
    %s3:sreg_32 = S_MOV_B32 4
    %s4:sreg_32 = S_MOV_B32 5
    S_NOP 0, implicit %s0, implicit %s1, implicit %s2, implicit %s3, implicit %s4
    %s_res:sreg_32 = S_ADD_I32 %s_far, %s_far, implicit-def $scc
    S_ENDPGM 0, implicit %s_res
...
