# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-SPILL
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-RA
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator,si-lower-sgpr-spills \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-LOWER

# Test: SGPR spill lowering — lane packing (two 32-bit SGPRs share one lane VGPR)
#
# CFG:
#
#   bb.0.entry ──► bb.1.pressure ──► bb.2.use
#
# Liveness:
#
#   %a:sreg_32   |══════════════════════════|  (def bb.0, use bb.2)
#   %b:sreg_32   |══════════════════════════|  (def bb.0, use bb.2)
#   %s0:sreg_32            |══|              (def + die in bb.1)
#   %s1–%s4:sreg_32        |══|
#
# With amdgpu-num-sgpr=8 → limit = floor(8 * 0.9) = 5.
# bb.0 exit liveness: %a(1) + %b(1) = 2, still at limit going into bb.1.
# bb.1: after first S_MOV, live set = %a + %b + %s0 = 3.
# After %s4 def: %a + %b + %s0–%s4 = 7 > 5 → spill %a first (NUD = 1 step away),
# then one more for %b → both spilled.
#
# Key assertion (AFTER-LOWER stage):
#   ONE IMPLICIT_DEF for a single lane VGPR (%N:vgpr_32).
#   %a spilled to lane 0, %b spilled to lane 1 of the SAME %N.
#   No second lane VGPR allocated — WaveSize = 32 lanes per VGPR is sufficient.
#
# Lane packing: SILowerSGPRSpills packs consecutive 32-bit spills into
# increasing lane indices of the same virtual VGPR until WaveSize is reached.

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @sgpr_lane_packing() #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }
  attributes #0 = { "amdgpu-num-sgpr"="7" "target-cpu"="gfx1200" }
...
---
name:            sgpr_lane_packing
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; === Stage 1: Spiller — two separate SI_SPILL_S32 pseudos, each with its own stack slot ===
  ; AFTER-SPILL-LABEL: name: sgpr_lane_packing
  ; AFTER-SPILL:         SI_SPILL_S32_SAVE %{{.*}}, %stack.{{[01]}}, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:         SI_SPILL_S32_SAVE %{{.*}}, %stack.{{[01]}}, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:       bb.2.use:
  ; AFTER-SPILL:         SI_SPILL_S32_RESTORE %stack.{{[01]}}, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:         SI_SPILL_S32_RESTORE %stack.{{[01]}}, implicit $exec, implicit $sgpr32

  ; === Stage 2: After SSA RA — both spills use physical $sgpr0 (reused) ===
  ; AFTER-RA-LABEL: name: sgpr_lane_packing
  ; AFTER-RA:         $sgpr0 = S_MOV_B32 100
  ; AFTER-RA-NEXT:    SI_SPILL_S32_SAVE $sgpr0, %stack.{{[01]}}, implicit $exec, implicit $sgpr32
  ; AFTER-RA:         $sgpr0 = S_MOV_B32 200
  ; AFTER-RA-NEXT:    SI_SPILL_S32_SAVE $sgpr0, %stack.{{[01]}}, implicit $exec, implicit $sgpr32

  ; === Stage 3: After SILowerSGPRSpills — ONE lane VGPR, lanes 0 and 1 ===
  ; Both spills packed into consecutive lanes of the same virtual VGPR:
  ;   %a → lane 0,  %b → lane 1.  Only ONE IMPLICIT_DEF emitted.
  ; AFTER-LOWER-LABEL: name: sgpr_lane_packing
  ; AFTER-LOWER:         $sgpr0 = S_MOV_B32 100
  ; AFTER-LOWER-NEXT:    %[[LANE:[0-9a-z_]+]]:vgpr_32 = IMPLICIT_DEF
  ; AFTER-LOWER-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, %[[LANE]]
  ; AFTER-LOWER-NEXT:    $sgpr0 = S_MOV_B32 200
  ; AFTER-LOWER-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 1, %[[LANE]]
  ; AFTER-LOWER:       bb.2.use:
  ; AFTER-LOWER:         $sgpr{{[0-9]+}} = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 1
  ; AFTER-LOWER-NEXT:    $sgpr{{[0-9]+}} = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 0
  ; AFTER-LOWER:         S_ENDPGM 0, implicit $sgpr0

  bb.0.entry:
    successors: %bb.1(0x80000000)
    %a:sreg_32 = S_MOV_B32 100
    %b:sreg_32 = S_MOV_B32 200
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)
    %s0:sreg_32 = S_MOV_B32 1
    %s1:sreg_32 = S_MOV_B32 2
    %s2:sreg_32 = S_MOV_B32 3
    %s3:sreg_32 = S_MOV_B32 4
    %s4:sreg_32 = S_MOV_B32 5
    S_NOP 0, implicit %s0, implicit %s1, implicit %s2, implicit %s3, implicit %s4
    S_BRANCH %bb.2

  bb.2.use:
    %res:sreg_32 = S_ADD_I32 %a, %b, implicit-def $scc
    S_ENDPGM 0, implicit %res
...
