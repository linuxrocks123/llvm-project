# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-SPILL
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-RA
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator,si-lower-sgpr-spills \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-LOWER

# Test: SGPR spill lowering — linear CFG, 64-bit SGPR, partial sub-register spill
#
# CFG:
#
#   bb.0.entry ──► bb.1.pressure ──► bb.2.use
#
# Liveness:
#
#   %w:sreg_64   |══════════════════════════|  (def bb.0, use bb.2 — spans pressure)
#   %s0:sreg_32            |══|              (def + die in bb.1)
#   %s1–%s5:sreg_32        |══|              (def + die in bb.1)
#
# With amdgpu-num-sgpr=10 → limit = floor(10 * 0.9) = 9 SGPRs.
# At %s5 def: %w(2) + %s0–%s5(6) = 8 live slots; at %s6 def it would reach 9,
# so spill triggers. %w has the longest NUD (used only in bb.2) and is chosen.
#
# Partial spill (fixed behaviour):
#   %w:sreg_64 only needs 1 slot freed. getRegSplitParts decomposes into sub0+sub1;
#   only sub0 (32-bit, 1 slot) is selected for spilling.
#   storeRegToStackSlot emits SI_SPILL_S32_SAVE %w:sub0 (SubRegIdx=sub0 honoured).
#   sub1 remains live; SSA repair inserts REG_SEQUENCE to reconstruct the full
#   64-bit value at the reload site.
#
# Spill stage:  SI_SPILL_S32_SAVE %w.sub0 (virtual, store-at-def in bb.0)
#               SI_SPILL_S32_RESTORE → REG_SEQUENCE reconstructs %w from
#               reloaded sub0 + surviving sub1
# RA stage:     SuperReg is physical $sgpr0; restore into $sgpr2, reassemble
#               $sgpr2_sgpr3 via REG_SEQUENCE
# Lower stage:  ONE SI_SPILL_S32_TO_VGPR $sgpr0, lane 0 (not two — sub1 never spilled)
#               ONE SI_RESTORE_S32_FROM_VGPR, then REG_SEQUENCE
#
# Note: amdgpu-num-sgpr=10 → hardware granule rounds up to 16; the spiller
# uses the 90% threshold over the requested value, giving limit 9.

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @sgpr_wide() #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }
  attributes #0 = { "amdgpu-num-sgpr"="10" "target-cpu"="gfx1200" }
...
---
name:            sgpr_wide
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; === Stage 1: Spiller — partial spill: only sub0 stored, sub1 stays live ===
  ; AFTER-SPILL-LABEL: name: sgpr_wide
  ; AFTER-SPILL:         SI_SPILL_S32_SAVE %{{.*}}.sub0, %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:       bb.2.use:
  ; AFTER-SPILL:         SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:         REG_SEQUENCE {{%[0-9]+}}, %subreg.sub0, {{%.*}}.sub1, %subreg.sub1

  ; === Stage 2: After SSA RA — sub0 is physical $sgpr0, sub1 is $sgpr1 ===
  ; AFTER-RA-LABEL: name: sgpr_wide
  ; AFTER-RA:         $sgpr0_sgpr1 = S_MOV_B64 0
  ; AFTER-RA-NEXT:    SI_SPILL_S32_SAVE $sgpr0, %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-RA:       bb.2.use:
  ; AFTER-RA:         SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-RA:         S_AND_B64

  ; === Stage 3: After SILowerSGPRSpills — ONE writelane/readlane only (sub0) ===
  ; AFTER-LOWER-LABEL: name: sgpr_wide
  ; AFTER-LOWER:         $sgpr0_sgpr1 = S_MOV_B64 0
  ; AFTER-LOWER-NEXT:    %[[LANE:[0-9a-z_]+]]:vgpr_32 = IMPLICIT_DEF
  ; AFTER-LOWER-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, %[[LANE]]
  ; AFTER-LOWER-NOT:     SI_SPILL_S32_TO_VGPR
  ; AFTER-LOWER:       bb.2.use:
  ; AFTER-LOWER:         $sgpr{{[0-9]+}} = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 0
  ; AFTER-LOWER-NOT:     SI_RESTORE_S32_FROM_VGPR
  ; AFTER-LOWER:         S_AND_B64

  bb.0.entry:
    successors: %bb.1(0x80000000)
    %w:sreg_64 = S_MOV_B64 0
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)
    %s0:sreg_32 = S_MOV_B32 1
    %s1:sreg_32 = S_MOV_B32 2
    %s2:sreg_32 = S_MOV_B32 3
    %s3:sreg_32 = S_MOV_B32 4
    %s4:sreg_32 = S_MOV_B32 5
    %s5:sreg_32 = S_MOV_B32 6
    S_NOP 0, implicit %s0, implicit %s1, implicit %s2, implicit %s3, implicit %s4, implicit %s5
    S_BRANCH %bb.2

  bb.2.use:
    %res:sreg_64 = S_AND_B64 %w, %w, implicit-def $scc
    S_ENDPGM 0, implicit %res
...
