# NOTE: FileCheck lines below are hand-maintained for virtual spill marker placement.
# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller --amdgpu-ssa-spill-markers=1 -o - %s | FileCheck %s

# Test SSA spiller Pattern 1.1: Simple Linear (Dominated Use, No EXEC)
# Verifies:
# 1. Basic spill/reload in dominated case (no split-before-use)
# 2. No WWM wrapping (no EXEC modifications on path)
# 3. Virtual spill point: SI_VIRTUAL_SPILL_MARKER after first bb.1 def, before
#    further defs (see --amdgpu-ssa-spill-markers=1 on RUN line)
# 4. Reload before use
# 5. No PHI insertion (dominated case)

--- |
  target datalayout = "e-p:64:64-p1:64:64-p2:32:32-p3:32:32-p4:64:64-p5:32:32-p6:32:32-i64:64-v16:16-v24:32-v32:32-v48:64-v96:128-v192:256-v256:256-v512:512-v1024:1024-v2048:2048-n32:64-S32-A5-G1-ni:7:8:9"
  target triple = "amdgcn"

  define amdgpu_kernel void @test_linear_dominated() #0 {
  bb0:
    br label %bb1

  bb1:
    br label %bb2

  bb2:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="7" }
...
---
name:            test_linear_dominated
alignment:       1
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vreg_64 }
  - { id: 2, class: vreg_64 }
  - { id: 3, class: vreg_128 }
  - { id: 4, class: vreg_64 }
  - { id: 5, class: vreg_64 }
stack:
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; CHECK-LABEL: name: test_linear_dominated
  ; CHECK:       bb.0:
  ; CHECK-NEXT:    successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{^  $}}
  ; CHECK-NEXT:    %[[TMP:[0-9]+]]:vreg_128 = IMPLICIT_DEF
  ; CHECK-NEXT:    %[[W:[0-9]+]]:vreg_128 = COPY %[[TMP]]
  ; CHECK-NEXT:    SI_SPILL_V32_SAVE %[[W]].sub0, %stack.0, $sgpr32, 0, implicit $exec ::
  ; CHECK-NEXT: {{^  $}}
  ; CHECK:       bb.1:
  ; CHECK-NEXT:    successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{^  $}}
  ; CHECK-NEXT:    %[[P1:[0-9]+]]:vreg_64 = IMPLICIT_DEF
  ; CHECK-NEXT:    SI_VIRTUAL_SPILL_MARKER %[[W]], 0000000000000003
  ; CHECK-NEXT:    %[[P2:[0-9]+]]:vreg_64 = IMPLICIT_DEF
  ; CHECK-NEXT:    %[[C1:[0-9]+]]:vreg_64 = COPY %[[P1]]
  ; CHECK-NEXT:    %[[C2:[0-9]+]]:vreg_64 = COPY %[[P2]]
  ; CHECK-NEXT:    S_NOP 0, implicit %[[C2]]
  ; CHECK-NEXT: {{^  $}}
  ; CHECK:       bb.2:
  ; CHECK-NEXT:    %[[RS:[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE %stack.0, $sgpr32, 0, implicit $exec ::
  ; CHECK-NEXT:    %[[R:[0-9]+]]:vreg_128 = REG_SEQUENCE %[[RS]], %subreg.sub0, {{.*}}.sub1_sub2_sub3, %subreg.sub1_sub2_sub3
  ; CHECK-NEXT:    S_ENDPGM 0, implicit %[[R]], implicit %[[C1]]

  bb.0:
    successors: %bb.1(0x80000000)

    %3:vreg_128 = IMPLICIT_DEF
    %0:vreg_128 = COPY %3

  ; High register pressure - forces spilling
  ; With amdgpu-num-vgpr=8, after 90% safety margin: floor(8 * 0.9) = 7 VGPRs available
  ; %0:vreg_128 defined in bb.0: RP = 4
  ; %1:vreg_64 defined: RP = 6
  ; Spill %1 here (tie-breaker prefers smaller): RP drops to 4
  ; %2:vreg_64 defined: RP = 6 (would be 8 without spill)
  ; %2 dies after use: RP = 4

  bb.1:
    successors: %bb.2(0x80000000)

    %4:vreg_64 = IMPLICIT_DEF
    %5:vreg_64 = IMPLICIT_DEF
    %1:vreg_64 = COPY %4
    %2:vreg_64 = COPY %5
    ; Use %2 to keep it live temporarily
    S_NOP 0, implicit %2
    ; %2 dies here, RP drops to 2

  ; Reload before use (dominated case - no split)

  bb.2:
    ; Use of spilled register (dominated by def in bb.0)
    ; Before reload: RP = 4 (%0 only, %1 was spilled)
    ; After reload: RP = 4 + 2 = 6 (within 7 limit)
    S_ENDPGM 0, implicit %0, implicit %1

...
