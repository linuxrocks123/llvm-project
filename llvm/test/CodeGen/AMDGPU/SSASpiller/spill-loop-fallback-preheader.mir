# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Spill point outside loop, use inside loop
# - High RP is OUTSIDE the loop (in entry block)
# - %x has use INSIDE loop - reload should go to preheader
# - This tests adjustReloadForLoop hoisting reload to preheader

# CHECK-LABEL: name: loop_fallback_preheader
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %x
# CHECK: SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.1.loop.preheader:
# CHECK: SI_SPILL_V32_RESTORE
# CHECK: bb.3.loop.body:
# CHECK-NOT: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @loop_fallback_preheader() #0 {
  entry:
    br label %loop.preheader
  loop.preheader:
    br label %loop.header
  loop.header:
    br i1 true, label %loop.body, label %exit
  loop.body:
    br label %loop.header
  exit:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            loop_fallback_preheader
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    
    ; %x defined outside loop
    %x:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    
    ; High RP here - need 5+ values live to exceed limit of 4
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %sum:vgpr_32 = V_ADD_U32_e32 %p0, %p1, implicit $exec
    %sum2:vgpr_32 = V_ADD_U32_e32 %sum, %p2, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.loop.preheader:
    successors: %bb.2(0x80000000)
    
    ; Reload should happen here (preheader)
    S_BRANCH %bb.2

  bb.2.loop.header:
    successors: %bb.3(0x40000000), %bb.4(0x40000000)
    
    %iter:vgpr_32 = PHI %sum2, %bb.1, %iter_next, %bb.3
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.3, implicit $scc
    S_BRANCH %bb.4

  bb.3.loop.body:
    successors: %bb.2(0x80000000)
    
    ; Use %x inside loop - but reload should be in preheader
    %tmp:vgpr_32 = V_ADD_U32_e32 %x, %iter, implicit $exec
    %iter_next:vgpr_32 = V_ADD_U32_e32 %tmp, %a0, implicit $exec
    S_BRANCH %bb.2

  bb.4.exit:
    S_ENDPGM 0
...
