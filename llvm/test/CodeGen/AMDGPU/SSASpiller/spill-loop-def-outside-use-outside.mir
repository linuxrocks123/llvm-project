# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Def outside loop, use outside loop - SAFE to spill
# CFG: entry -> loop.header <-> loop.body -> exit
# %x defined in entry, used in exit, high RP in loop.body
# Expected: %x spilled (def/use both outside loop = safe)

# CHECK-LABEL: name: loop_def_outside_use_outside
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE
# CHECK: SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.3.exit:
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @loop_def_outside_use_outside() #0 {
  entry:
    br label %loop.header
  loop.header:
    br i1 true, label %loop.body, label %exit
  loop.body:
    br label %loop.header
  exit:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            loop_def_outside_use_outside
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    
    ; Define %x outside loop
    %x:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_BRANCH %bb.1

  bb.1.loop.header:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    
    %iter:vgpr_32 = PHI %a0, %bb.0, %iter_next, %bb.2
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2.loop.body:
    successors: %bb.1(0x80000000)
    
    ; High RP here - %x should be spilled
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    %iter_next:vgpr_32 = V_ADD_U32_e32 %iter, %p2, implicit $exec
    S_BRANCH %bb.1

  bb.3.exit:
    ; Use %x outside loop
    dead %result:vgpr_32 = V_ADD_U32_e32 %x, %iter, implicit $exec
    S_ENDPGM 0
...
