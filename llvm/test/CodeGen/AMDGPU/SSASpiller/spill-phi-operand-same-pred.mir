# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-no-reload-opt \
# RUN:   -amdgpu-ssa-spill-markers -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: PHI with uses of spilled register - reloads at use sites
#
# Scenario:
# - Standard diamond CFG with spill
# - Both left and right paths use %x
# - Each gets a reload before use
# - PHI at join merges computed values (not %x directly)
#
# CHECK-LABEL: name: phi_operand_test
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %x
# CHECK: bb.2.left:
# Reload in left path
# CHECK: SI_SPILL_V32_RESTORE
# CHECK: bb.3.right:
# Reload in right path
# CHECK: SI_SPILL_V32_RESTORE
# CHECK: bb.4.join:
# PHI merges computed values
# CHECK: PHI

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @phi_operand_test() #0 {
  entry:
    br label %high_rp
  high_rp:
    br i1 true, label %left, label %right
  left:
    br label %join
  right:
    br label %join
  join:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" "target-cpu"="gfx1200" }
...
---
name:            phi_operand_test
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)

    ; Define %x and pressure registers
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.high_rp:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)

    ; Create high RP - need 4 live (limit=3)
    ; a0, a1, x, p0 = 4 live at peak
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    ; now a0, a1, x, p0 = 4 live, exceeds limit of 3
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2.left:
    successors: %bb.4(0x80000000)

    ; Use %x - triggers reload
    %left_val:vgpr_32 = V_ADD_U32_e32 %x, %p0, implicit $exec
    
    S_BRANCH %bb.4

  bb.3.right:
    successors: %bb.4(0x80000000)

    ; Use %x - triggers reload
    %right_val:vgpr_32 = V_ADD_U32_e32 %x, %p2, implicit $exec
    
    S_BRANCH %bb.4

  bb.4.join:
    ; PHI merges computed values (not %x)
    %merged:vgpr_32 = PHI %left_val, %bb.2, %right_val, %bb.3
    
    S_ENDPGM 0, implicit %merged
...
