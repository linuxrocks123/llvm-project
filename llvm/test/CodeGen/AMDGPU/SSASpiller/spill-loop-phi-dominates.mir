# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: PHI at loop header - PHI defined inside loop
#
# Setup:
#   %phi: PHI at loop header (def inside loop), use in exit → FILTERED
#   %good: def in entry (outside loop), use in exit → KEPT
#   %a0, %a1: used in loop.body to create high RP → FILTERED
#
# Only %good survives filtering

# CHECK-LABEL: name: loop_phi_dominates
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE %good
# CHECK-NOT: SI_SPILL_V32_SAVE %phi

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @loop_phi_dominates() #0 {
  entry:
    br label %loop.header
  loop.header:
    br i1 true, label %loop.body, label %exit
  loop.body:
    br label %loop.header
  exit:
    ret void
  }
  attributes #0 = { "amdgpu-num-vgpr"="3" }
...
---
name:            loop_phi_dominates
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |
  bb.0.entry:
    successors: %bb.1(0x80000000)
    %good:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    %init:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_BRANCH %bb.1

  bb.1.loop.header:
    successors: %bb.2(0x40000000), %bb.3(0x40000000)
    ; PHI defined at loop header - inside loop, should be filtered
    %phi:vgpr_32 = PHI %init, %bb.0, %phi_next, %bb.2
    %cond:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %cond, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.3

  bb.2.loop.body:
    successors: %bb.1(0x80000000)
    ; High RP - uses only a0/a1, not %good or %phi
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    %phi_next:vgpr_32 = V_ADD_U32_e32 %a0, %p2, implicit $exec
    S_BRANCH %bb.1

  bb.3.exit:
    ; Both %good and %phi used OUTSIDE loop
    %r1:vgpr_32 = V_ADD_U32_e32 %good, %a0, implicit $exec
    dead %result:vgpr_32 = V_ADD_U32_e32 %r1, %phi, implicit $exec
    S_ENDPGM 0
...
