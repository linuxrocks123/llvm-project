# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: Physreg dies mid-block — pressure drops, no false spill
#
# CFG:
#     bb.0 (entry)
#     liveins: $vgpr0
#     S_NOP implicit $vgpr0    ; $vgpr0 dies (pressure drops to 0)
#     %a = V_MOV 1             ; pressure: 1
#     %b = V_MOV 2             ; pressure: 2
#     %c = V_MOV 3             ; pressure: 3 = limit
#     S_ENDPGM implicit %a, %b, %c
#
# Live ranges:
#         NOP    MOV   MOV   MOV   ENDPGM
#  $vgpr0 |=====|
#  %a             |=====|=====|=====|
#  %b                   |=====|=====|
#  %c                         |=====|
#
# amdgpu-num-vgpr=4, limit = floor(4*0.9) = 3
# With correct physreg kill tracking:
#   $vgpr0 freed at S_NOP, peak pressure = 3 ≤ limit. No spill.
# With broken tracking (physreg never freed):
#   peak = 3 + 1 = 4 > limit. False spill.
#
# CHECK-LABEL: name: physreg_dies
# CHECK-NOT: SI_SPILL

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @physreg_dies() #0 {
  entry:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            physreg_dies
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |

  bb.0.entry:
    liveins: $vgpr0

    S_NOP 0, implicit $vgpr0
    %a:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %b:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %c:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    S_ENDPGM 0, implicit %a, implicit %b, implicit %c
...
