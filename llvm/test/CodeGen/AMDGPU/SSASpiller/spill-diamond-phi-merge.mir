# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-no-reload-opt -amdgpu-ssa-spill-markers -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: Simple Diamond with 3 uses + bypass path (no use)
#
# CFG Structure:
#       bb.0 (entry, define x)
#        / \
#       v   \
#      bb.1  \
#   (high RP) \
#     / \      \
#    v   v      |
#  bb.2 bb.5    |
# (use x)(use x)|
#     \ /       |
#      v        |
#    bb.3       |
#   (use x)     |
#      |        |
#      v        v
#    bb.4 <-----+
#   (use x)
#
# Expected results:
# 1. PHI in bb.3 merges reloads from bb.2 and bb.5
# 2. use in bb.3 replaced with PHI result
# 3. PHI in bb.4 merges value from bb.3 and ORIGINAL x from Entry->4 bypass

# CHECK-LABEL: name: diamond_phi_merge
# CHECK: bb.0.entry:
# CHECK:   SI_SPILL_V32_SAVE %x,
# CHECK: bb.1.high_rp:
# CHECK:   SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.2.left:
# CHECK:   [[R2:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK:   V_ADD_U32_e32 [[R2]], %p0
# CHECK: bb.3.right:
# CHECK:   [[R3:%[0-9]+]]:vgpr_32 = SI_SPILL_V32_RESTORE
# CHECK:   V_ADD_U32_e32 [[R3]], %p1
# CHECK: bb.4.join:
# bb.4 merges the two reloads via a PHI -- no third reload of x.
# CHECK:   [[PHI4:%[0-9]+]]:vgpr_32 = PHI [[R2]], %bb.2, [[R3]], %bb.3
# CHECK:   PHI %u0, %bb.2, %v0, %bb.3
# CHECK:   V_ADD_U32_e32 [[PHI4]], %j0
# CHECK: bb.5.exit:
# bb.5 merges the ORIGINAL x (from the bb.0 bypass, never spilled) with the join
# value via a PHI -- no reload on the clean path.
# CHECK:   [[PHI5:%[0-9]+]]:vgpr_32 = PHI %x, %bb.0, [[PHI4]], %bb.4
# CHECK:   PHI %w0, %bb.4, %a0, %bb.0
# CHECK:   V_ADD_U32_e32 [[PHI5]],
# CHECK:   S_ENDPGM 0

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @diamond_phi_merge(i32 %in0) #0 {
  entry:
    br i1 true, label %high_rp, label %exit
  high_rp:
    br i1 true, label %left, label %right
  left:
    br label %join
  right:
    br label %join
  join:
    br label %exit
  exit:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" }
...

---
name:            diamond_phi_merge
isSSA:           true
tracksRegLiveness: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  ; =========================
  ; bb.0 (entry): Define x here, then branch to bb.1 (high RP) or bb.4 (bypass)
  ; =========================
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.4(0x40000000)

    ; Define x here - it will be live on ALL paths
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec

    ; branch: to high_rp path or bypass
    %c_entry:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %c_entry, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.4

  ; =========================
  ; bb.1 (high_rp): High register pressure here causes spill of x
  ; x is live but has furthest next-use
  ; =========================
  bb.1.high_rp:
    successors: %bb.2(0x40000000), %bb.5(0x40000000)

    ; Create pressure - reuse a0, a1 and add more
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a1, implicit $exec
    ; At this point: x, a0, a1, p0, p1, p2 = 6 live, but a0/a1 die soon
    ; After p2: x, p0, p1, p2 = 4 live + x = 5 if spilled, we get under limit

    ; branch: left (use x) or right (use x)
    %c0:sgpr_32 = S_MOV_B32 0
    S_CMP_EQ_U32 %c0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.5

  ; =========================
  ; bb.2 (left): use x
  ; =========================
  bb.2.left:
    successors: %bb.3(0x80000000)

    ; use x - triggers reload
    %u0:vgpr_32 = V_ADD_U32_e32 %x, %p0, implicit $exec

    S_BRANCH %bb.3

  ; =========================
  ; bb.5 (right): use x
  ; =========================
  bb.5.right:
    successors: %bb.3(0x80000000)

    ; use x - triggers reload
    %v0:vgpr_32 = V_ADD_U32_e32 %x, %p1, implicit $exec

    S_BRANCH %bb.3

  ; =========================
  ; bb.3 (join): use x - PHI merges reloads from bb.2 and bb.5
  ; =========================
  bb.3.join:
    successors: %bb.4(0x80000000)

    ; PHI for values from left/right
    %j0:vgpr_32 = PHI %u0, %bb.2, %v0, %bb.5

    ; use x
    %w0:vgpr_32 = V_ADD_U32_e32 %x, %j0, implicit $exec

    S_BRANCH %bb.4

  ; =========================
  ; bb.4 (exit): use x
  ; Predecessors: bb.0 (bypass, has ORIGINAL x), bb.3 (has reload via PHI)
  ; =========================
  bb.4.exit:
    ; PHI for values from both paths
    %e0:vgpr_32 = PHI %w0, %bb.3, %a0, %bb.0

    ; use x - PHI merges reloaded value and original x
    %final0:vgpr_32 = V_ADD_U32_e32 %x, %e0, implicit $exec

    S_ENDPGM 0
...
