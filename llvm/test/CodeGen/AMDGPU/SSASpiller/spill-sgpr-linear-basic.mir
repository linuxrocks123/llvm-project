# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-SPILL
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-RA
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 \
# RUN:   -run-pass=amdgpu-ssa-register-spiller,amdgpu-ssa-register-allocator,si-lower-sgpr-spills \
# RUN:   -o - %s | FileCheck %s --check-prefix=AFTER-LOWER

# Test: SGPR spill lowering — linear CFG, single 32-bit SGPR
#
# CFG:  bb.0.entry → bb.1.pressure → bb.2.use
#
# With amdgpu-num-sgpr=8 → limit = floor(8 * 0.9) = 5 (spiller 90% threshold).
# Liveness at bb.1 entry: %s_far(1) + %s0-%s4(5) = 6 > 5.
# Spiller picks %s_far (longest NUD — next use only in bb.2).
#
# Stage SPILL: SI_SPILL_S32_SAVE/RESTORE emitted with virtual SGPR; pseudos survive.
# Stage RA:    SSA RA assigns physregs; SuperReg in pseudo becomes physical $sgpr0.
# Stage LOWER: SILowerSGPRSpills materialises pseudo → SI_SPILL_S32_TO_VGPR (writelane)
#              + IMPLICIT_DEF for lane VGPR + SI_RESTORE_S32_FROM_VGPR (readlane).
#              No SI_SPILL pseudo survives past this stage.

--- |
  target triple = "amdgcn-amd-amdhsa"
  define amdgpu_kernel void @sgpr_linear_basic() #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }
  attributes #0 = { "amdgpu-num-sgpr"="8" "target-cpu"="gfx1200" }
...
---
name:            sgpr_linear_basic
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment: 4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |
  ; === Stage 1: Spiller — virtual SGPR in pseudo ===
  ; AFTER-SPILL-LABEL: name: sgpr_linear_basic
  ; AFTER-SPILL:         SI_SPILL_S32_SAVE %{{.*}}, %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-SPILL:       bb.1.pressure:
  ; AFTER-SPILL:       bb.2.use:
  ; AFTER-SPILL:         {{%[0-9]+}}:sreg_32{{.*}} = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32

  ; === Stage 2: After SSA RA — SuperReg is physical ===
  ; AFTER-RA-LABEL: name: sgpr_linear_basic
  ; AFTER-RA:         $sgpr0 = S_MOV_B32 200
  ; AFTER-RA-NEXT:    SI_SPILL_S32_SAVE $sgpr0, %stack.0, implicit $exec, implicit $sgpr32
  ; AFTER-RA:       bb.2.use:
  ; AFTER-RA:         $sgpr0 = SI_SPILL_S32_RESTORE %stack.0, implicit $exec, implicit $sgpr32

  ; === Stage 3: After SILowerSGPRSpills — writelane/readlane ===
  ; AFTER-LOWER-LABEL: name: sgpr_linear_basic
  ; AFTER-LOWER:         $sgpr0 = S_MOV_B32 200
  ; AFTER-LOWER-NEXT:    %[[LANE:[0-9a-z_]+]]:vgpr_32 = IMPLICIT_DEF
  ; AFTER-LOWER-NEXT:    %[[LANE]]:vgpr_32 = SI_SPILL_S32_TO_VGPR $sgpr0, 0, %[[LANE]]
  ; AFTER-LOWER:       bb.1.pressure:
  ; AFTER-LOWER-NOT:     SI_SPILL
  ; AFTER-LOWER:       bb.2.use:
  ; AFTER-LOWER-NEXT:    $sgpr0 = SI_RESTORE_S32_FROM_VGPR %[[LANE]], 0
  ; AFTER-LOWER:         S_ENDPGM 0, implicit $sgpr0

  bb.0.entry:
    successors: %bb.1(0x80000000)
    %s_far:sreg_32 = S_MOV_B32 200
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)
    %s0:sreg_32 = S_MOV_B32 1
    %s1:sreg_32 = S_MOV_B32 2
    %s2:sreg_32 = S_MOV_B32 3
    %s3:sreg_32 = S_MOV_B32 4
    %s4:sreg_32 = S_MOV_B32 5
    S_NOP 0, implicit %s0, implicit %s1, implicit %s2, implicit %s3, implicit %s4
    S_BRANCH %bb.2

  bb.2.use:
    %s_res:sreg_32 = S_ADD_I32 %s_far, %s_far, implicit-def $scc
    S_ENDPGM 0, implicit %s_res
...
