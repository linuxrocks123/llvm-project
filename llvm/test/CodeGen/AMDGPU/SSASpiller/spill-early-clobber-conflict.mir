# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Spill selection with USE operands at high-RP instruction
#
# Scenario:
# - At high RP point, %input is used by the current instruction
# - %input has longest NUD from the NEXT instruction onwards
# - But at the current instruction, %input has distance 0 (used now)
# - Spiller should NOT spill %input (needed immediately)
# - Spiller should select %other (which is not used at current MI)
#
# CHECK-LABEL: name: early_clobber_test
# CHECK: bb.0.entry:
# %other should be spilled (not used at high-RP instruction)
# CHECK: SI_SPILL_V32_SAVE %other
# %input should NOT be spilled (used at high-RP instruction)
# CHECK-NOT: SI_SPILL_V32_SAVE %input

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @early_clobber_test() #0 {
  entry:
    br label %pressure
  pressure:
    br label %use
  use:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="3" "target-cpu"="gfx1200" }
...
---
name:            early_clobber_test
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)

    ; Define registers
    ; %input will be used at the high-RP instruction
    ; %other will NOT be used at the high-RP instruction but has use in bb.2
    %input:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %other:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %a0:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.pressure:
    successors: %bb.2(0x80000000)

    ; High RP point - %input is USED HERE (distance=0 at this instruction)
    ; input, other, a0, p0 = 4 live at peak (limit=3), triggers spill
    ; %input cannot be spilled (used at current instruction)
    ; %other should be spilled (longest NUD among candidates)
    %p0:vgpr_32 = V_ADD_U32_e32 %input, %a0, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %a0, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %input, implicit $exec
    
    S_BRANCH %bb.2

  bb.2.use:
    ; Use %other here (it was spilled, needs reload)
    %result:vgpr_32 = V_ADD_U32_e32 %other, %p2, implicit $exec
    S_ENDPGM 0, implicit %result
...
