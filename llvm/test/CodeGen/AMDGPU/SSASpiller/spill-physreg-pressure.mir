# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s
#
# Test: Physreg live-in contributes to pressure — spiller must account for it
#
# CFG:
#     bb.0 (entry)
#     liveins: $vgpr0
#     %a = V_MOV 1             ;  $vgpr0 + %a = 2
#     %b = V_MOV 2             ;  $vgpr0 + %a + %b = 3
#     %c = V_MOV 3             ;  $vgpr0 + %a + %b + %c = 4 > limit
#     S_BRANCH bb.1
#
#     bb.1 (use)
#     S_NOP implicit $vgpr0    ;  $vgpr0 dies
#     %r = V_ADD %a, %b
#     S_ENDPGM implicit %r, %c
#
# Live ranges:
#         bb.0                      bb.1
#  $vgpr0 |==========================|
#  %a      |==========================|========|
#  %b         |=======================|========|
#  %c            |====================|==================|
#  %r                                          |=========|
#
# amdgpu-num-vgpr=4, limit = floor(4*0.9) = 3
# Without physreg fix: CurRP=3 (vregs only) ≤ 3, no spill
# With physreg fix:    CurRP=3+1=4 > 3, spills %c (longest NUD)
#
# CHECK-LABEL: name: physreg_pressure
# CHECK: bb.0.entry:
# CHECK: SI_SPILL_V32_SAVE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @physreg_pressure() #0 {
  entry:
    br label %use
  use:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            physreg_pressure
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body: |

  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $vgpr0

    %a:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %b:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %c:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
    S_BRANCH %bb.1

  bb.1.use:
    liveins: $vgpr0
    S_NOP 0, implicit $vgpr0
    %r:vgpr_32 = V_ADD_U32_e32 %a, %b, implicit $exec
    S_ENDPGM 0, implicit %r, implicit %c
...
