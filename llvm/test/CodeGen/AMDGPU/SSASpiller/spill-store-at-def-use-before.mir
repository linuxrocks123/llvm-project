# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -amdgpu-ssa-spill-markers \
# RUN:   -verify-machineinstrs -run-pass=amdgpu-ssa-register-spiller -o - %s | FileCheck %s

# Test: Store-at-definition with use before spill point
#
# Scenario:
# - %x defined in bb.0
# - %x used in bb.1 (BEFORE high RP)
# - High RP in bb.2 triggers spill of %x
# - %x used again in bb.3 (AFTER spill)
#
# Expected:
# 1. Store emitted right after definition in bb.0
# 2. Store has isKill=false (register still live for bb.1 use)
# 3. %x remains live through bb.1 use
# 4. Virtual spill marker at high RP point in bb.2
# 5. Reload before use in bb.3
#
# CHECK-LABEL: name: store_at_def_use_before
# CHECK: bb.0.entry:
# Store right after def, register NOT killed (still needed in bb.1)
# CHECK: %x:vgpr_32 = V_ADD_U32_e32
# CHECK-NEXT: SI_SPILL_V32_SAVE %x
# CHECK: bb.1.early_use:
# %x still live here, used directly (not reloaded)
# CHECK: V_ADD_U32_e32 %x
# CHECK: bb.2.high_rp:
# Virtual spill marker here (where RP relief is intended)
# CHECK: SI_VIRTUAL_SPILL_MARKER %x
# CHECK: bb.3.late_use:
# Reload needed for this use
# CHECK: SI_SPILL_V32_RESTORE

--- |
  target triple = "amdgcn-amd-amdhsa"

  define amdgpu_kernel void @store_at_def_use_before() #0 {
  entry:
    br label %early_use
  early_use:
    br label %high_rp
  high_rp:
    br label %late_use
  late_use:
    ret void
  }

  attributes #0 = { "amdgpu-num-vgpr"="4" "target-cpu"="gfx1200" }
...
---
name:            store_at_def_use_before
tracksRegLiveness: true
isSSA: true
frameInfo:
  maxAlignment:    4
machineFunctionInfo:
  stackPtrOffsetReg: '$sgpr32'
body:             |

  bb.0.entry:
    successors: %bb.1(0x80000000)

    ; Define %x here - will be stored immediately after
    %a0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %a1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    %x:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    
    S_BRANCH %bb.1

  bb.1.early_use:
    successors: %bb.2(0x80000000)

    ; Use %x BEFORE high RP point
    ; This use should see the ORIGINAL %x (not reloaded)
    ; Store at def must have isKill=false to keep %x live here
    %early_result:vgpr_32 = V_ADD_U32_e32 %x, %a0, implicit $exec
    
    S_BRANCH %bb.2

  bb.2.high_rp:
    successors: %bb.3(0x80000000)

    ; Create high register pressure - %x has longest NUD
    %p0:vgpr_32 = V_ADD_U32_e32 %a0, %a1, implicit $exec
    %p1:vgpr_32 = V_ADD_U32_e32 %p0, %early_result, implicit $exec
    %p2:vgpr_32 = V_ADD_U32_e32 %p1, %a0, implicit $exec
    %p3:vgpr_32 = V_ADD_U32_e32 %p2, %a1, implicit $exec
    
    ; Virtual spill point here - %x becomes dead for RP purposes
    
    S_BRANCH %bb.3

  bb.3.late_use:
    ; Use %x AFTER spill point - needs reload
    %late_result:vgpr_32 = V_ADD_U32_e32 %x, %p3, implicit $exec
    S_ENDPGM 0, implicit %late_result
...
