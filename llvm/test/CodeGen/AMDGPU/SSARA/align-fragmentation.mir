# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Test: Cross-block alignment fragmentation on gfx90a.
# Per-block width-descending places %1 at VGPR1, blocking the even pair
# VGPR0-1 for the 64-bit aligned def in bb.1. Function-wide coloring
# would place the 64-bit def first at VGPR0-1, then %1 at VGPR2.
#
# CFG:
#   bb.0                           bb.1
#   %0 = V_MOV 1                   %2:vreg_64_align2 = IMPLICIT_DEF
#   %1 = V_MOV 2                   S_ENDPGM implicit %1, %2
#   S_NOP implicit %0 (%0 dies)
#   S_BRANCH bb.1
#
# Live ranges:
#            bb.0              bb.1
#  %0(32)    |=====|
#  %1(32)         |===================|
#  %2(64a2)                    |======|
#
# Current (per-block): %2 → VGPR2-3 (MaxVGPR=4)
# Expected (function-wide): %2 → VGPR0-1 (MaxVGPR=3)

# CHECK: bb.1:
# CHECK: $vgpr0_vgpr1 = IMPLICIT_DEF
# CHECK: S_ENDPGM 0, implicit $vgpr2, implicit $vgpr0_vgpr1

--- |
  define amdgpu_kernel void @test_align_frag() {
  bb0:
    br label %bb1
  bb1:
    ret void
  }
...
---
name:            test_align_frag
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vreg_64_align2 }
body: |
  bb.0:
    successors: %bb.1
    %0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_NOP 0, implicit %0
    S_BRANCH %bb.1

  bb.1:
    %2:vreg_64_align2 = IMPLICIT_DEF
    S_ENDPGM 0, implicit %1, implicit %2
...
