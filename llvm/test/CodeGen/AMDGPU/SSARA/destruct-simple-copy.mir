# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Diamond CFG with a live-through value forcing a COPY on one PHI edge.
#
# CFG:
#   bb.0 → bb.1 (fallthrough)
#   bb.0 → bb.2 (execz)
#   bb.1 → bb.3
#   bb.2 → bb.3
#
# Live ranges:
#          bb.0       bb.1       bb.2       bb.3
#   %a(32) |——————————————————————————————————|
#   %b(32)             |——————————————————————|  (bb.1 path only)
#   %c(32)                                |——|  (PHI result)
#
# Coloring:
#   %a → VGPR0 (live everywhere)
#   %b → VGPR1 (interferes with %a in bb.1)
#   %c → VGPR1 (PHI result, %a still live past PHI)
#
# SSA destruction:
#   bb.1 edge: %b(VGPR1) → %c(VGPR1) = identity, no copy
#   bb.2 edge: %a(VGPR0) → %c(VGPR1) = COPY inserted

# CHECK-LABEL: name: test_destruct_simple_copy
# CHECK: bb.1:
# CHECK:      $vgpr1 = V_MOV_B32_e32 42
# CHECK-NEXT: S_BRANCH %bb.3
# CHECK: bb.2:
# CHECK:      $vgpr1 = COPY $vgpr0
# CHECK-NEXT: S_BRANCH %bb.3
# CHECK: bb.3:
# CHECK-NOT: PHI
# CHECK: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1

--- |
  define amdgpu_kernel void @test_destruct_simple_copy() #0 {
  bb0:
    br i1 undef, label %bb1, label %bb2
  bb1:
    br label %bb3
  bb2:
    br label %bb3
  bb3:
    ret void
  }
  attributes #0 = { "target-cpu"="gfx1200" }
...
---
name:            test_destruct_simple_copy
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vgpr_32 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    %0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    S_CBRANCH_EXECZ %bb.2, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    %1:vgpr_32 = V_MOV_B32_e32 42, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.3:
    %2:vgpr_32 = PHI %1, %bb.1, %0, %bb.2
    S_ENDPGM 0, implicit %0, implicit %2
...
