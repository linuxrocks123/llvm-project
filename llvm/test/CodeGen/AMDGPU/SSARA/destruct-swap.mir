# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Test: Diamond CFG, two cross-referencing PHIs produce a swap (cycle of 2)
#
# CFG:
#           bb.0 (def %0, %1)
#           /    \
#          v   (execz)
#        bb.1      bb.2
#       (empty)  (empty)
#          \      /
#           v    v
#           bb.3
#        %2 = PHI(%0, bb.1, %1, bb.2)
#        %3 = PHI(%1, bb.1, %0, bb.2)
#        S_ENDPGM implicit %2, %3
#
# Live ranges:
#          bb.0       bb.1       bb.2       bb.3
#   %0(32) |============================================|
#   %1(32) |============================================|
#   %2(32)                                     |========|
#   %3(32)                                     |========|
#
# Coloring: %0→VGPR0, %1→VGPR1, %2→VGPR0, %3→VGPR1
#
# Expected:
#   bb.1: both identities
#   bb.2: VGPR0↔VGPR1 swap via scratch (Tier 1)

# CHECK-LABEL: name: test_destruct_swap
# CHECK: bb.1:
# CHECK-NOT: COPY
# CHECK: S_BRANCH %bb.3
# CHECK: bb.2:
# CHECK:      $vgpr2 = COPY $vgpr1
# CHECK-NEXT: $vgpr1 = COPY $vgpr0
# CHECK-NEXT: $vgpr0 = COPY $vgpr2
# CHECK-NEXT: S_BRANCH %bb.3
# CHECK: bb.3:
# CHECK-NOT: PHI
# CHECK: S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1

--- |
  define amdgpu_kernel void @test_destruct_swap() #0 {
  bb0:
    br i1 undef, label %bb1, label %bb2
  bb1:
    br label %bb3
  bb2:
    br label %bb3
  bb3:
    ret void
  }
  attributes #0 = { "target-cpu"="gfx1200" }
...
---
name:            test_destruct_swap
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vgpr_32 }
  - { id: 3, class: vgpr_32 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    %0:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_CBRANCH_EXECZ %bb.2, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.3:
    %2:vgpr_32 = PHI %0, %bb.1, %1, %bb.2
    %3:vgpr_32 = PHI %1, %bb.1, %0, %bb.2
    S_ENDPGM 0, implicit %2, implicit %3
...
