# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Test: Loop, %x alive past V_ADD — COPY on back edge required
#
# CFG:
#        bb.0 (def %0)          bb.2 (latch)
#        S_BRANCH bb.1          %2 = V_ADD %1, 1
#             \                 S_NOP implicit %1  (%1 alive!)
#              v                S_BRANCH bb.1
#           bb.1 (header)  <-------+
#        %1 = PHI(%0, bb.0, %2, bb.2)
#        S_CBRANCH_EXECZ bb.3
#                |
#                v
#           bb.3 (exit)
#
# Live ranges:
#          bb.0       bb.1       bb.2
#   %0(32) |===========|
#   %1(32)             |======================|
#   %2(32)                         |===========|
#                                  ^-- %1 and %2 overlap here
#
# %1 alive past V_ADD (S_NOP uses it). %2 cannot reuse VGPR0.
# Coloring: %0→VGPR0, %1→VGPR0, %2→VGPR1
#
# Expected: COPY $vgpr0, $vgpr1 on back edge

# CHECK: bb.2:
# CHECK:      $vgpr1 = V_ADD_U32_e64 $vgpr0, 1, 0
# CHECK-NEXT: S_NOP 0, implicit $vgpr0
# CHECK-NEXT: $vgpr0 = COPY $vgpr1
# CHECK-NEXT: S_BRANCH %bb.1
# CHECK: bb.3:
# CHECK: S_ENDPGM

--- |
  define amdgpu_kernel void @test_destruct_loop() #0 {
  entry:
    br label %header
  header:
    br i1 undef, label %body, label %exit
  body:
    br label %header
  exit:
    ret void
  }
  attributes #0 = { "target-cpu"="gfx1200" }
...
---
name:            test_destruct_loop
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vgpr_32 }
body: |
  bb.0:
    successors: %bb.1
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    %1:vgpr_32 = PHI %0, %bb.0, %2, %bb.2
    S_CBRANCH_EXECZ %bb.3, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.1
    %2:vgpr_32 = V_ADD_U32_e64 %1, 1, 0, implicit $exec
    S_NOP 0, implicit %1
    S_BRANCH %bb.1

  bb.3:
    S_ENDPGM 0
...
