# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Positive counterpart to lowerphi-critical-edge-no-split.ll: lowerPHIs MUST
# split the critical edge here.
#
# CFG:                         bb.0 (def %0, %1)
#                                |
#                              bb.1  --exec--> bb.2 (sibling, uses %0)
#                          (crit edge)\          |
#                                       v        v
#                                        bb.3 = PHI(%1 from bb.1, %2 from bb.2)
#
# Coloring: %0->VGPR0, %1->VGPR1, %2->VGPR0, %3->VGPR0.
# The bb.1->bb.3 edge is critical (bb.1 has 2 succ, bb.3 has 2 pred). The PHI
# edge copy is "VGPR0 = COPY VGPR1", but VGPR0 holds %0, which is live into the
# sibling bb.2. Placing the copy at bb.1's terminator would clobber it, so the
# edge is split and the copy lands in a fresh block (bb.4).

# CHECK-LABEL: name: test_lowerphi_critical_edge_split
# CHECK: bb.1:
# CHECK: S_CBRANCH_EXECNZ %bb.2
# The split block carries the edge copy, isolated from the bb.1 -> bb.2 path.
# CHECK: bb.4:
# CHECK:      $vgpr0 = COPY $vgpr1
# CHECK-NEXT: S_BRANCH %bb.3
# The sibling still sees %0 in VGPR0, unclobbered.
# CHECK: bb.2:
# CHECK: $vgpr0 = V_ADD_U32_e64 $vgpr0, 1, 0, implicit $exec

--- |
  define amdgpu_kernel void @test_lowerphi_critical_edge_split() {
  bb0:
    br label %bb1
  bb1:
    br i1 undef, label %bb2, label %bb3
  bb2:
    br label %bb3
  bb3:
    ret void
  }
...
---
name:            test_lowerphi_critical_edge_split
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vgpr_32 }
  - { id: 3, class: vgpr_32 }
body: |
  bb.0:
    successors: %bb.1
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    S_CBRANCH_EXECZ %bb.3, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.3
    %2:vgpr_32 = V_ADD_U32_e64 %0, 1, 0, implicit $exec
    S_BRANCH %bb.3

  bb.3:
    %3:vgpr_32 = PHI %1, %bb.1, %2, %bb.2
    S_ENDPGM 0, implicit %3
...
