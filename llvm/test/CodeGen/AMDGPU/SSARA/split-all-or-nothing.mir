# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=amdgpu-ssa-register-allocator \
# RUN:   -debug-only=amdgpu-ssa-register-allocator -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts
#
# All-or-nothing: target threshold cannot be reached, no splits applied.
#
# Live ranges:
#   A(%0,128) |-----|
#   E(%1,128) |-----|
#   B(%2,32)  |-----|
#              bb.0
#
# All vregs live simultaneously in a single BB. No epoch boundaries
# (no vreg dies before another). Splitting is impossible.
# Splitter should detect this and make no changes.

# CHECK: Coloring result:
# CHECK-NOT: Committed split

--- |
  define amdgpu_kernel void @test_split_all_or_nothing() #0 { ret void }
  attributes #0 = { "amdgpu-num-vgpr"="12" "target-cpu"="gfx1200" }
...
---
name:            test_split_all_or_nothing
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vreg_128 }
  - { id: 1, class: vreg_128 }
  - { id: 2, class: vgpr_32 }
body: |
  bb.0:
    %0:vreg_128 = IMPLICIT_DEF
    %1:vreg_128 = IMPLICIT_DEF
    %2:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    S_ENDPGM 0, implicit %0, implicit %1, implicit %2
...
