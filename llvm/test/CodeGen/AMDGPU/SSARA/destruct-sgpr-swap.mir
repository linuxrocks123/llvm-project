# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Test: Diamond CFG, two cross-referencing SGPR PHIs produce a swap (cycle of 2).
# SGPRs have no scalar swap instruction, and SCC is dead at the branch, so the
# cycle is broken in place with an S_XOR_B32 triplet (not a scratch register).

# CHECK-LABEL: name: test_destruct_sgpr_swap
# CHECK: bb.1:
# CHECK-NOT: COPY
# CHECK: S_BRANCH %bb.3
# CHECK: bb.2:
# CHECK:      $sgpr0 = S_XOR_B32 $sgpr0, $sgpr1, implicit-def $scc
# CHECK-NEXT: $sgpr1 = S_XOR_B32 $sgpr0, $sgpr1, implicit-def $scc
# CHECK-NEXT: $sgpr0 = S_XOR_B32 $sgpr0, $sgpr1, implicit-def $scc
# CHECK-NEXT: S_BRANCH %bb.3
# CHECK: bb.3:
# CHECK-NOT: PHI
# CHECK: S_ENDPGM 0, implicit $sgpr0, implicit $sgpr1

--- |
  define amdgpu_kernel void @test_destruct_sgpr_swap() {
  bb0:
    br i1 undef, label %bb1, label %bb2
  bb1:
    br label %bb3
  bb2:
    br label %bb3
  bb3:
    ret void
  }
...
---
name:            test_destruct_sgpr_swap
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: sgpr_32 }
  - { id: 1, class: sgpr_32 }
  - { id: 2, class: sgpr_32 }
  - { id: 3, class: sgpr_32 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr_32 = S_MOV_B32 1
    %1:sgpr_32 = S_MOV_B32 2
    S_CBRANCH_EXECZ %bb.2, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.3:
    %2:sgpr_32 = PHI %0, %bb.1, %1, %bb.2
    %3:sgpr_32 = PHI %1, %bb.1, %0, %bb.2
    S_ENDPGM 0, implicit %2, implicit %3
...
