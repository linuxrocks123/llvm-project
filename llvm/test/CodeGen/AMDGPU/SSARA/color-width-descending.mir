# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=amdgpu-ssa-register-allocator \
# RUN:   -debug-only=amdgpu-ssa-register-allocator -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts

# Width-descending: defs appear in order 32, 128, 64 but coloring processes 128 first.
# All live simultaneously: %0(32) + %1(128) + %2(64) = 7 units.
# 128-bit gets lowest physregs regardless of def order.
#
# Using two BBs to ensure the 128-bit def dominates and is live-in when
# the 32-bit pass processes bb.1, so the wider-def is caught by seed.

# CHECK: Coloring order (width descending): 128 64 32
# CHECK: Coloring result:
# CHECK-DAG: %1 -> VGPR0_VGPR1_VGPR2_VGPR3
# CHECK-DAG: %2 -> VGPR4_VGPR5
# CHECK-DAG: %0 -> VGPR6

--- |
  define amdgpu_kernel void @test_width_descending() #0 {
  bb0:
    br label %bb1
  bb1:
    ret void
  }
  attributes #0 = { "target-cpu"="gfx1200" }
...
---
name:            test_width_descending
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vreg_128 }
  - { id: 2, class: vreg_64 }
body: |
  bb.0:
    successors: %bb.1
    %1:vreg_128 = IMPLICIT_DEF
    %2:vreg_64 = IMPLICIT_DEF
    S_BRANCH %bb.1

  bb.1:
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    S_ENDPGM 0, implicit %0, implicit %1, implicit %2
...
