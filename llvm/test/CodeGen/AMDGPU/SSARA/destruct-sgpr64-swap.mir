# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs \
# RUN:   -run-pass=amdgpu-ssa-register-allocator -o - %s | FileCheck %s
# REQUIRES: asserts
#
# Test: 64-bit SGPR 2-cycle. Broken in place with a single S_XOR_B64 triplet
# (widest scalar XOR for a 64-bit chunk), since SCC is dead at the branch.

# CHECK-LABEL: name: test_destruct_sgpr64_swap
# CHECK: bb.2:
# CHECK:      $sgpr0_sgpr1 = S_XOR_B64 $sgpr0_sgpr1, $sgpr2_sgpr3, implicit-def $scc
# CHECK-NEXT: $sgpr2_sgpr3 = S_XOR_B64 $sgpr0_sgpr1, $sgpr2_sgpr3, implicit-def $scc
# CHECK-NEXT: $sgpr0_sgpr1 = S_XOR_B64 $sgpr0_sgpr1, $sgpr2_sgpr3, implicit-def $scc
# CHECK-NEXT: S_BRANCH %bb.3

--- |
  define amdgpu_kernel void @test_destruct_sgpr64_swap() {
  bb0:
    br i1 undef, label %bb1, label %bb2
  bb1:
    br label %bb3
  bb2:
    br label %bb3
  bb3:
    ret void
  }
...
---
name:            test_destruct_sgpr64_swap
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: sgpr_64 }
  - { id: 1, class: sgpr_64 }
  - { id: 2, class: sgpr_64 }
  - { id: 3, class: sgpr_64 }
body: |
  bb.0:
    successors: %bb.1, %bb.2
    %0:sgpr_64 = S_MOV_B64 1
    %1:sgpr_64 = S_MOV_B64 2
    S_CBRANCH_EXECZ %bb.2, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    S_BRANCH %bb.3

  bb.3:
    %2:sgpr_64 = PHI %0, %bb.1, %1, %bb.2
    %3:sgpr_64 = PHI %1, %bb.1, %0, %bb.2
    S_ENDPGM 0, implicit %2, implicit %3
...
