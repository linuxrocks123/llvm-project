# RUN: llc -mtriple=amdgcn -mcpu=gfx1200 -verify-machineinstrs -run-pass=amdgpu-ssa-register-allocator \
# RUN:   -debug-only=amdgpu-ssa-register-allocator -o /dev/null %s 2>&1 | FileCheck %s
# REQUIRES: asserts
#
# Basic coloring: 3 VGPR_32 vregs in a straight line.
#
# Live ranges:
#   %0(32) |-----|
#   %1(32) |-----------|
#   %2(32)       |-----|
#          def   kill0  end
#
# %0 and %1 live simultaneously. %0 dies, then %2 reuses %0's physreg.
# Max VGPR index = 2

# CHECK: Coloring order (width descending): 32
# CHECK: Coloring result:
# CHECK-DAG: %0 -> VGPR0
# CHECK-DAG: %1 -> VGPR1
# CHECK-DAG: %2 -> VGPR0

--- |
  define amdgpu_kernel void @test_basic_coloring() #0 { ret void }
  attributes #0 = { "target-cpu"="gfx1200" }
...
---
name:            test_basic_coloring
tracksRegLiveness: true
isSSA:           true
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vgpr_32 }
body: |
  bb.0:
    %0:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %1:vgpr_32 = V_MOV_B32_e32 1, implicit $exec
    S_NOP 0, implicit %0
    %2:vgpr_32 = V_MOV_B32_e32 2, implicit $exec
    S_ENDPGM 0, implicit %1, implicit %2
...
